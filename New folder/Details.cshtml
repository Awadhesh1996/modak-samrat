@page
@model DetailsModel

<link href="\css\bootstrap.min.css" rel="stylesheet">

<div class="details-container">

    <!-- BACK -->
    <a href="/" class="back-btn">
        ← Back
    </a>

    <div class="details-grid">

        <!-- IMAGES -->

        <div>

            <div class="main-image">

                <img id="mainPreview"
                     src="@Model.Modak.Images.FirstOrDefault()">

            </div>

            <!-- THUMBNAILS -->

            <div class="thumb-row">

                @foreach (var img in Model.Modak.Images)
                {
                    <img src="@img"
                         class="thumb"
                         onclick="changeImage('@img')">
                }

            </div>

        </div>

        <!-- INFO -->

        <div class="info-box">

            <div class="badge-custom">
                @Model.Modak.CategoryName
            </div>

            <h1>
                @Model.Modak.Name
            </h1>

            <div class="price">
                ₹@Model.Modak.Price
            </div>

            <p class="desc">
                @Model.Modak.Description
            </p>

            <!-- QTY -->

            <div class="qty-box">

                <button onclick="changeQty(-1)">
                    −
                </button>

                <input type="number"
                       id="qty"
                       value="1"
                       min="1">

                <button onclick="changeQty(1)">
                    +
                </button>

            </div>

            <!-- BUTTONS -->

            <button class="cart-btn"
                    onclick="addToCart()">

                Add to Cart 🛒

            </button>

            <a href="javascript:void(0)"
               onclick="orderWhatsApp()"
               class="whatsapp-btn">

                Order on WhatsApp 📱

            </a>

        </div>

    </div>

    <!-- RELATED -->

    @if (Model.RelatedModaks.Count > 0)
    {
        <h3 class="related-title">
            Related Modaks
        </h3>

        <div class="related-grid">

            @foreach (var item in Model.RelatedModaks)
            {
                <a href="/Details?id=@item.Id"
                   class="related-card">

                    <img src="@item.Images.FirstOrDefault()">

                    <div class="related-name">
                        @item.Name
                    </div>

                    <div class="related-price">
                        ₹@item.Price
                    </div>

                </a>
            }

        </div>
    }

</div>

<style>

body{
    background:#f4f6f9;
    font-family:'Segoe UI',sans-serif;
}

.details-container{
    max-width:1200px;
    margin:auto;
    padding:30px;
}

.back-btn{
    text-decoration:none;
    color:#0f172a;
    font-weight:600;
}

.details-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;

    margin-top:20px;
}

/* IMAGE */

.main-image{
    background:white;
    border-radius:20px;
    overflow:hidden;
}

.main-image img{
    width:100%;
    height:500px;
    object-fit:cover;
}

/* THUMB */

.thumb-row{
    display:flex;
    gap:10px;

    margin-top:15px;
}

.thumb{
    width:90px;
    height:90px;

    object-fit:cover;

    border-radius:12px;

    cursor:pointer;

    border:2px solid transparent;
}

.thumb:hover{
    border-color:#0f172a;
}

/* INFO */

.info-box{
    background:white;

    padding:30px;

    border-radius:20px;

    box-shadow:0 4px 15px rgba(0,0,0,0.05);
}

.badge-custom{
    display:inline-block;

    background:#0f172a;
    color:white;

    padding:6px 12px;

    border-radius:12px;

    margin-bottom:15px;
}

.price{
    font-size:36px;
    font-weight:bold;

    margin-top:15px;

    color:#ff7b00;
}

.desc{
    color:#64748b;

    line-height:1.7;

    margin-top:20px;
}

/* QTY */

.qty-box{
    display:flex;
    align-items:center;

    gap:10px;

    margin-top:25px;
}

.qty-box button{
    width:40px;
    height:40px;

    border:none;

    border-radius:50%;

    background:#0f172a;
    color:white;

    cursor:pointer;
}

.qty-box input{
    width:60px;
    text-align:center;

    height:40px;

    border-radius:10px;
    border:1px solid #ddd;
}

/* BUTTONS */

.cart-btn,
.whatsapp-btn{
    width:100%;

    margin-top:20px;

    padding:14px;

    border:none;

    border-radius:14px;

    background:linear-gradient(135deg,#0f172a,#1e293b);

    color:white;

    text-decoration:none;

    display:block;

    text-align:center;
}

/* RELATED */

.related-title{
    margin-top:50px;
}

.related-grid{
    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(200px,1fr));

    gap:20px;

    margin-top:20px;
}

.related-card{
    background:white;

    border-radius:20px;

    overflow:hidden;

    text-decoration:none;

    color:black;

    box-shadow:0 4px 15px rgba(0,0,0,0.05);
}

.related-card img{
    width:100%;
    height:180px;

    object-fit:cover;
}

.related-name{
    padding:10px;
    font-weight:600;
}

.related-price{
    padding:0 10px 15px;
    color:#ff7b00;
    font-weight:bold;
}

/* MOBILE */

@@media(max-width:768px){

    .details-grid{
        grid-template-columns:1fr;
    }

    .main-image img{
        height:320px;
    }

}

</style>

<script>

function changeImage(src){
    document
    .getElementById("mainPreview")
    .src = src;
}

function changeQty(change){

    let qty =
    document.getElementById("qty");

    let value =
    parseInt(qty.value);

    value += change;

    if(value < 1)
        value = 1;

    qty.value = value;
}

function addToCart(){

    let qty =
    document.getElementById("qty")
    .value;

    alert(
        "@Model.Modak.Name added x" +
        qty
    );
}

function orderWhatsApp(){

    let qty =
    document.getElementById("qty")
    .value;

    let msg =
    `I want to order @Model.Modak.Name (Qty: ${qty})`;

    let url =
    "https://wa.me/917021923652?text="
    + encodeURIComponent(msg);

    window.open(url,"_blank");
}

</script>