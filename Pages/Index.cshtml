.ms-slide-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.35);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.15);color:#fff;width:34px;height:34px;border-radius:50%;font-size:20px;cursor:pointer;z-index:10;transition:all .2s;display:flex;align-items:center;justify-content:center;opacity:0}
.ms-card:hover .ms-slide-btn{opacity:1}
.ms-slide-btn:hover{background:rgba(201,147,58,.7)}
.ms-slide-btn--prev{left:10px}.ms-slide-btn--next{right:10px}
.ms-slide-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:5px;z-index:10}
