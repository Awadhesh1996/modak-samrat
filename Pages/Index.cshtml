.ms-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px;padding:0 32px 60px}

.ms-card{background:var(--card-bg);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .35s cubic-bezier(.22,.61,.36,1),box-shadow .35s;position:relative;border:1px solid rgba(201,147,58,.08);animation:fadeUp .5s ease both}
