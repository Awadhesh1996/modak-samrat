.ms-card__actions{display:flex;gap:10px}
.ms-btn{flex:1;padding:12px 10px;border:none;border-radius:12px;font-size:13px;font-weight:600;font-family:var(--font-body);cursor:pointer;transition:all .25s;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:6px;letter-spacing:.03em}
