.ms-ribbon{position:absolute;top:16px;left:-2px;z-index:20;font-size:11px;font-weight:700;padding:5px 14px 5px 10px;border-radius:0 20px 20px 0;letter-spacing:.04em;box-shadow:0 2px 10px rgba(0,0,0,.2)}
