@@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
</style>

<script>
/* ── THEMES AND SLIDER ──────────────────────── */
function toggleDarkMode(){document.body.classList.toggle('dark');localStorage.setItem('msDark',document.body.classList.contains('dark')?'1':'0')}
if(localStorage.getItem('msDark')==='1')document.body.classList.add('dark');

const sliders={};
function changeSlide(id,dir){
    const w=document.getElementById('slider-'+id);
    const s=w.querySelectorAll('.ms-card__slide'),d=w.querySelectorAll('.ms-dot');
    if(!sliders[id])sliders[id]=0;
    s[sliders[id]].classList.remove('active');if(d.length)d[sliders[id]].classList.remove('active');
    sliders[id]=(sliders[id]+dir+s.length)%s.length;
    s[sliders[id]].classList.add('active');if(d.length)d[sliders[id]].classList.add('active');
}
function goToSlide(id,idx){
    const w=document.getElementById('slider-'+id);
    const s=w.querySelectorAll('.ms-card__slide'),d=w.querySelectorAll('.ms-dot');
    if(!sliders[id])sliders[id]=0;
    s[sliders[id]].classList.remove('active');if(d.length)d[sliders[id]].classList.remove('active');
    sliders[id]=idx;s[sliders[id]].classList.add('active');if(d.length)d[sliders[id]].classList.add('active');
}
document.querySelectorAll('.ms-card__media').forEach(w=>{
    const id=w.id.split('-')[1];
    if(w.querySelectorAll('.ms-card__slide').length>1)setInterval(()=>changeSlide(id,1),3500+Math.random()*1500);
});

/* ── DISCOUNTS, PILLS, QTY ───────────────────── */
function getDiscount(qty){
    if(qty>=20)return 20;
    if(qty>=15)return 15;
    if(qty>=10)return 10;
    if(qty>=5) return 5;
    return 0;
}
function setPieces(id,n){
    const input=document.getElementById('qty-'+id);
    input.value=n;
    const card=input.closest('.ms-card');
    card.querySelectorAll('.ms-pill').forEach(p=>p.classList.remove('active'));
    event.target.classList.add('active');
    updatePrice(id);
}
function changeQty(id,delta){
    const i=document.getElementById('qty-'+id);
    i.value=Math.max(1,parseInt(i.value)+delta);
    document.getElementById('qty-'+id).closest('.ms-card').querySelectorAll('.ms-pill').forEach(p=>p.classList.remove('active'));
    updatePrice(id);
}
function updatePrice(id){
    const i=document.getElementById('qty-'+id),e=document.getElementById('price-'+id);
    const q=Math.max(1,parseInt(i.value)||1);
    i.value=q;
    const base=parseInt(e.dataset.baseprice);
    const gift=document.getElementById('gift-'+id)?.checked;
    const disc=getDiscount(q);
    const subtotal=base*q;
    const discounted=Math.round(subtotal*(1-disc/100));
    const total=discounted+(gift?50:0);
    e.textContent=total;
    const badge=document.getElementById('disc-'+id);
    if(disc>0){
        badge.style.display='block';
        badge.textContent='🎉 '+disc+'% bulk discount applied on '+q+' items!';
    } else {
        badge.style.display='none';
    }
}

/* ── PERSISTENT CART ───────────────────── */
function loadCart(){return JSON.parse(localStorage.getItem('msCart')||'[]')}
function saveCart(c){localStorage.setItem('msCart',JSON.stringify(c))}

function addToCart(name,price,id,unit){
    const gift=document.getElementById('gift-'+id)?.checked;
    const qty=parseInt(document.getElementById('qty-'+id).value);
    const giftCost=gift?50:0;
    const disc=getDiscount(qty);
    const originalTotal=price*qty;
    const discountedSubtotal=Math.round(originalTotal*(1-disc/100));
    const finalTotal=discountedSubtotal+giftCost;
    const label=gift?name+' \uD83C\uDF81':name;
    const key='item_'+id+(gift?'_gift':'');
    let cart=loadCart();
    const ex=cart.find(i=>i.key===key);
    if(ex){
        ex.qty+=qty;
        const newOrig=price*ex.qty;
        const newDisc=getDiscount(ex.qty);
        ex.discPct=newDisc;
        ex.originalTotal=newOrig;
        ex.total=Math.round(newOrig*(1-newDisc/100))+ex.giftCost;
    } else {
        cart.push({key,id,name:label,price,giftCost,qty,unit,discPct:disc,originalTotal,total:finalTotal});
    }
    saveCart(cart);renderCart();toggleCart(true);
}
function updateCartItemQty(key, delta){
    let cart=loadCart();
    const idx=cart.findIndex(i=>i.key===key);
    if(idx>-1){
        cart[idx].qty += delta;
        if(cart[idx].qty <= 0){
            cart.splice(idx, 1);
        } else {
            const it = cart[idx];
            const newOrig = it.price * it.qty;
            const newDisc = getDiscount(it.qty);
            it.discPct = newDisc;
            it.originalTotal = newOrig;
            it.total = Math.round(newOrig * (1 - newDisc/100)) + (it.giftCost || 0);
        }
        saveCart(cart);
        renderCart();
    }
}
function clearCart(){saveCart([]);renderCart()}
function toggleCart(forceOpen){
    const d=document.getElementById('cartDrawer'),b=document.getElementById('cartBackdrop');
    const open=d.classList.contains('open');
    if(forceOpen===true||!open){d.classList.add('open');b.classList.add('open')}
    else{d.classList.remove('open');b.classList.remove('open')}
}
function renderCart(){
    const cart=loadCart();
    const container=document.getElementById('cartItems'),foot=document.getElementById('cartFoot');
    const count=document.getElementById('cartCount'),totalWrap=document.getElementById('cartTotalWrap');
    const totalQty=cart.reduce((s,i)=>s+i.qty,0);
    const grossTotal=cart.reduce((s,i)=>s+i.originalTotal+(i.giftCost||0),0);
    const discountedTotal=cart.reduce((s,i)=>s+i.total,0);
    const totalSavings=grossTotal-discountedTotal;
    
    count.style.display=totalQty>0?'flex':'none';count.textContent=totalQty;
    const floatCount=document.getElementById('floatCartCount');
    if(floatCount){floatCount.style.display=totalQty>0?'flex':'none';floatCount.textContent=totalQty;}
    foot.style.display=cart.length?'block':'none';
    if(!cart.length){container.innerHTML='<div class="ms-cart-empty">Your cart is empty \uD83D\uDED2</div>';totalWrap.innerHTML='';return}

    container.innerHTML=cart.map(i=>{
        const giftLine=i.giftCost?`<span style="color:var(--gold);font-size:11px;display:block;margin-top:2px;"> + \u20B950 gift wrap</span>`:'';
        const meta=`${i.qty} \u00D7 \u20B9${i.price}`+(i.discPct?` (${i.discPct}% off)`:'');
        const priceBlock=i.discPct
            ? `<div style="text-align:right">
                 <div class="ms-cart-item__original">\u20B9${i.originalTotal+(i.giftCost||0)}</div>
                 <div class="ms-cart-item__final">\u20B9${i.total}</div>
                 <div class="ms-cart-item__disc" style="margin-top:2px">${i.discPct}% off</div>
               </div>`
            : `<div style="text-align:right"><div class="ms-cart-item__final">\u20B9${i.total}</div></div>`;
            
        return `<div class="ms-cart-item">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div class="ms-cart-item__name">${i.name}</div>
                    <div class="ms-cart-item__meta">${meta} ${giftLine}</div>
                </div>
                <button class="ms-cart-item__remove" onclick="updateCartItemQty('${i.key}', -9999)" title="Remove item">&#10005;</button>
            </div>
            <div class="ms-cart-item__footer">
                <div class="ms-cart-qty">
                    <button onclick="updateCartItemQty('${i.key}', -1)">&#8722;</button>
                    <span>${i.qty}</span>
                    <button onclick="updateCartItemQty('${i.key}', 1)">+</button>
                </div>
                ${priceBlock}
            </div>
        </div>`;
    }).join('');

    let totalHtml=`<div class="ms-cart-total__row"><span>Items subtotal</span><span>\u20B9${grossTotal}</span></div>`;
    if(totalSavings>0)
        totalHtml+=`<div class="ms-cart-total__savings">\uD83C\uDF89 You save \u20B9${totalSavings} on bulk discounts!</div>`;

    if(activeDelivery){
        const isCustom = activeDelivery.charge === 'Custom';
        // Apply free delivery rule for Zone A when cart >= ₹500
        let actualCharge = isCustom ? 0 : Number(activeDelivery.charge);
        if(activeDelivery.zone === 'Zone A' && discountedTotal >= 500) actualCharge = 0;

        let dLabel;
        if(isCustom){
            dLabel = `<span style="color:var(--muted);font-style:italic">To be confirmed</span>`;
        } else if(actualCharge === 0){
            dLabel = `<span style="color:#1e6b4a;font-weight:700">FREE \u2705</span>`;
        } else {
            dLabel = `\u20B9${actualCharge}`;
        }

        totalHtml+=`<div class="ms-cart-total__row">
            <span>Delivery (${activeDelivery.area})</span>
            <span>${dLabel}</span>
        </div>`;

        if(!isCustom && actualCharge > 0 && activeDelivery.zone === 'Zone A')
            totalHtml+=`<div style="font-size:11px;color:var(--muted);margin-bottom:4px">Add \u20B9${500-discountedTotal} more for FREE delivery \uD83D\uDE9A</div>`;

        // Grand total — only show number if charge is known
        const grandTotal = discountedTotal + actualCharge;
        if(isCustom){
            totalHtml+=`<div class="ms-cart-total__final"><span>Items Total</span><span>\u20B9${discountedTotal}</span></div>`;
            totalHtml+=`<div style="font-size:12px;color:var(--muted);text-align:right;margin-top:4px">+ delivery (to be confirmed)</div>`;
        } else {
            totalHtml+=`<div class="ms-cart-total__final"><span>Grand Total</span><span>\u20B9${grandTotal}</span></div>`;
        }
    } else {
        totalHtml+=`<div class="ms-cart-total__row" style="font-style:italic"><span>Delivery</span><span style="color:var(--muted)">Calculated at checkout</span></div>`;
        totalHtml+=`<div class="ms-cart-total__final"><span>Items Total</span><span>\u20B9${discountedTotal}</span></div>`;
    }
    totalWrap.innerHTML=`<div class="ms-cart-total">${totalHtml}</div>`;
}

/* ── DELIVERY HELPERS ──────────────────── */
const SHOP = {lat:19.021055, lng:72.835238};
let activeDelivery = null;

function deg2rad(d){return d*(Math.PI/180)}
function getDistance(lat1,lng1,lat2,lng2){
    const R=6371;
    const dLat=deg2rad(lat2-lat1),dLng=deg2rad(lng2-lng1);
    const a=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(deg2rad(lat1))*Math.cos(deg2rad(lat2))*Math.sin(dLng/2)*Math.sin(dLng/2);
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
function calcDeliveryCharge(distKm){
    if(distKm<=5)return{charge:30,time:'30–40 mins',zone:'Zone A',free:false};
    if(distKm<=8)return{charge:50,time:'45–60 mins',zone:'Zone B',free:false};
    return null;
}
function showDeliveryResult(type, html){
    const r=document.getElementById('deliveryResult');
    r.style.display='block';
    r.className='ms-delivery__result '+type;
    r.innerHTML=html;
}

async function checkDelivery(){
    const raw = document.getElementById('pincodeInput').value.trim();
    if(!raw){ showDeliveryResult('err','Please enter a pincode or area name.'); return; }
    showDeliveryResult('warn','🔍 Looking up location…');

    try {
        const res = await fetch(`/api/delivery-check?q=${encodeURIComponent(raw)}`);
        const data = await res.json();
        if(data.error){ showDeliveryResult('err', data.error); return; }
        if(!data.deliverable){
            activeDelivery = null;
            showDeliveryResult('err', `📍 <strong>${data.area}</strong> is ${data.dist}km away — Currently not delivering here. <a href="https://wa.me/917021923652" target="_blank" style="color:#c9933a;font-weight:700">Contact us</a> to arrange.`);
            return;
        }
        activeDelivery = { charge: data.charge, time: data.time, zone: data.zone, free: data.charge === 0, area: data.area, dist: data.dist };
        renderCart();
        const cartVal = loadCart().reduce((s,i)=>s+i.total,0);
        const actualCharge = (data.zone==='Zone A' && cartVal>=500) ? 0 : data.charge;
        const chargeText = actualCharge===0 ? '<strong style="color:#1e6b4a">FREE ✅</strong>' : `<strong>₹${actualCharge}</strong>`;
        const hint = actualCharge>0 && data.zone==='Zone A' ? `<br><small style="color:var(--muted)">Add ₹${500-cartVal} more for FREE delivery</small>` : '';
        showDeliveryResult('ok', `✅ <strong>${data.area}</strong> &nbsp;·&nbsp; ${data.dist} km &nbsp;·&nbsp; Delivery: ${chargeText} &nbsp;·&nbsp; ⏱ ${data.time}${hint}`);
    } catch(e) {
        showDeliveryResult('err', 'Something went wrong. Please use <strong>My Location</strong> button instead.');
    }
}

function useMyLocation(){
    if(!navigator.geolocation){ showDeliveryResult('err','Geolocation is not supported by your browser.'); return; }
    showDeliveryResult('warn','📍 Getting your location…');
    navigator.geolocation.getCurrentPosition(
        pos=>{
            const dist=getDistance(SHOP.lat,SHOP.lng,pos.coords.latitude,pos.coords.longitude);
            const info=calcDeliveryCharge(dist);
            if(!info){
                activeDelivery = null;
                showDeliveryResult('err',`📍 <strong>Your Location</strong> is ${dist.toFixed(1)}km away — Currently not delivering here. <a href="https://wa.me/917021923652" target="_blank" style="color:#c9933a;font-weight:700">Contact us</a>.`);
                return;
            }
            activeDelivery = {...info, dist: dist.toFixed(1), area: 'Your Location'};
            renderCart();
            const chargeText=info.free ? '<strong style="color:#1e6b4a">FREE ✅</strong>' : `<strong>₹${info.charge}</strong>`;
            showDeliveryResult('ok',`✅ <strong>Your Location</strong> &nbsp;·&nbsp; ${dist.toFixed(1)} km &nbsp;·&nbsp; Delivery: ${chargeText} &nbsp;·&nbsp; ⏱ ${info.time}`);
        },
        err=>{ showDeliveryResult('err', 'Could not get your location. Please type your pincode manually.'); },
        {timeout:8000}
    );
}

/* ── SMART WHATSAPP POPUP & LOGIC ──────────────── */
let pendingOrderData = null;
let pendingIsCart = false;

function openWaModal(orderData, isCart) {
    if (activeDelivery) {
        executeWhatsAppRedirect(orderData, isCart, activeDelivery);
        return;
    }
    pendingOrderData = orderData;
    pendingIsCart = isCart;
    document.getElementById('waModalOverlay').classList.add('show');
    document.getElementById('waModal').classList.add('show');
    setTimeout(() => document.getElementById('waModalInput').focus(), 100);
}

function closeWaModal() {
    document.getElementById('waModalOverlay').classList.remove('show');
    document.getElementById('waModal').classList.remove('show');
}

async function submitWaModal() {
    const loc = document.getElementById('waModalInput').value.trim();
    if(!loc) { alert("Please enter a location."); return; }
    
    const btn = document.getElementById('waModalSubmitBtn');
    btn.innerHTML = 'Calculating...'; btn.disabled = true;

    try {
        const res = await fetch(`/api/delivery-check?q=${encodeURIComponent(loc)}`);
        const data = await res.json();
        
        // NO LONGER BLOCKING. If lookup fails or out of range, we just set a "Custom" charge status.
        if(data.error || !data.deliverable) {
            activeDelivery = { charge: 'Custom', time: 'To be confirmed', zone: 'Out of Range', free: false, area: loc, dist: data.dist || '?' };
        } else {
            activeDelivery = { charge: data.charge, time: data.time, zone: data.zone, free: data.charge === 0, area: data.area, dist: data.dist };
        }
        
        closeWaModal();
        btn.innerHTML = 'Order'; btn.disabled = false;
        renderCart(); 
        executeWhatsAppRedirect(pendingOrderData, pendingIsCart, activeDelivery);
    } catch(e) {
        // Fallback: If API fails, proceed anyway with "To be confirmed" status
        activeDelivery = { charge: 'Custom', time: 'To be confirmed', zone: 'Unknown', free: false, area: loc, dist: '?' };
        closeWaModal();
        btn.innerHTML = 'Order'; btn.disabled = false;
        executeWhatsAppRedirect(pendingOrderData, pendingIsCart, activeDelivery);
    }
}
function useMyLocationModal() {
    if (!navigator.geolocation) { alert("Geolocation not supported."); return; }
    
    const btn = document.getElementById('waModalLocBtn');
    btn.innerHTML = '⏳'; btn.disabled = true;
    
    navigator.geolocation.getCurrentPosition(
        pos => {
            const dist = getDistance(SHOP.lat, SHOP.lng, pos.coords.latitude, pos.coords.longitude);
            const info = calcDeliveryCharge(dist);
            
            // FIX: Don't block! If info is null, set to Custom instead of alerting
            if (!info) {
                activeDelivery = { 
                    charge: 'Custom', 
                    time: 'To be confirmed', 
                    zone: 'Out of Range', 
                    free: false, 
                    area: 'Your Location', 
                    dist: dist.toFixed(1) 
                };
            } else {
                activeDelivery = { ...info, area: "Your Location", dist: dist.toFixed(1) };
            }
            
            closeWaModal();
            btn.innerHTML = '📍'; btn.disabled = false;
