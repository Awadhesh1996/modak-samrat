@page
@model IndexModel

@{
    ViewData["Title"] = "Modak Samrat – Premium Handcrafted Modaks";
}

<meta name="description" content="Premium handcrafted modaks. Order online or via WhatsApp.">
<meta property="og:title" content="Modak Samrat – Premium Handcrafted Modaks">
<meta property="og:image" content="/images/modak.png">

<div class="ms-root" id="msRoot">

    <header class="ms-header">
        <div class="ms-header__glow"></div>
        <div class="ms-header__noise"></div>

        <nav class="ms-nav">
            <div class="ms-nav__logo">
                <img src="/images/modak.png" alt="Modak" class="ms-nav__logo-img" loading="lazy">
                <div class="ms-nav__logo-text">
                    <span class="ms-nav__brand">Modak Samrat</span>
                    <span class="ms-nav__tagline">The King of Sweets</span>
                </div>
            </div>
            <div class="ms-nav__actions">

                <button class="ms-dark-toggle" onclick="toggleDarkMode()" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
                </button>
                <div class="ms-cart-bubble" id="cartBubble" onclick="toggleCart()" title="View Cart">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                    <span class="ms-cart-count" id="cartCount" style="display:none">0</span>
                </div>
            </div>
        </nav>

        <div class="ms-hero">
            <div class="ms-hero__eyebrow">✦ Handcrafted since generations ✦</div>
            <h1 class="ms-hero__title">
                <span class="ms-hero__title-line">Premium</span>
                <em class="ms-hero__title-italic">Modaks</em>
                <span class="ms-hero__title-line">Reimagined</span>
            </h1>
            <p class="ms-hero__sub">Pure ingredients. Ancient recipes. Modern indulgence.</p>
            <div class="ms-search-wrap">
                <svg class="ms-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="text" id="searchInput" class="ms-search" placeholder="Search modaks…" onkeyup="searchProducts()">
            </div>
        </div>
    </header>

    <section class="ms-delivery">
        <div class="ms-delivery__inner">
            <div class="ms-delivery__left">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                    <div class="ms-delivery__title">Check Delivery Availability</div>
                    <div class="ms-delivery__sub">Know distance, delivery charges &amp; time</div>
                </div>
            </div>
            <div class="ms-delivery__form">
                <div class="ms-delivery__input-wrap">
                    <input type="text" id="pincodeInput" class="ms-delivery__input" placeholder="Enter pincode or area name" onkeydown="if(event.key==='Enter')checkDelivery()">
                    <button class="ms-delivery__loc-icon-btn" onclick="useMyLocation()" title="Use My Location" aria-label="Use My Location">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
                    </button>
                    <button class="ms-delivery__check-btn" onclick="checkDelivery()">Check</button>
                </div>
            </div>
            <div class="ms-delivery__result" id="deliveryResult" style="display:none"></div>
        </div>
    </section>

    <section class="ms-badges">
        <div class="ms-badges__track" id="badgesTrack">
            @for (int i = 0; i < 4; i++)
            {
                @foreach (var badge in Model.TrustBadges)
                {
                    <div class="ms-badge" aria-hidden="@(i > 0 ? "true" : "false")">
                        <span class="ms-badge__icon">@badge.Icon</span>
                        <span class="ms-badge__text">@badge.Title</span>
                    </div>
                }
            }
        </div>
    </section>

    <section class="ms-categories">
        <div class="ms-categories__track">
            <button class="ms-cat active" onclick="filterCategory('all', this)">All</button>
            @foreach (var category in Model.Categories)
            {
                <button class="ms-cat" onclick="filterCategory('@category.Name', this)">@category.Name</button>
            }
        </div>
    </section>

    <div class="ms-section-head">
        <div class="ms-section-head__line"></div>
        <h2 class="ms-section-head__title">Our Collection</h2>
        <div class="ms-section-head__line"></div>
    </div>

    <main class="ms-grid" id="productsGrid">
        @{
            var allIds = Model.Modaks.Select(m => m.Id).ToList();
            var bestSellerIds = allIds.Take(2).ToHashSet();
            var newIds = allIds.Skip(2).Take(2).ToHashSet();
        }
        @foreach (var modak in Model.Modaks)
        {
            bool isBestSeller = bestSellerIds.Contains(modak.Id);
            bool isNew        = newIds.Contains(modak.Id);

            <article class="ms-card searchable" data-category="@modak.CategoryName" data-price="@modak.Price" data-id="@modak.Id">

                @if (isBestSeller)
                {
                    <div class="ms-ribbon ms-ribbon--best">⭐ Best Seller</div>
                }
                else if (isNew)
                {
                    <div class="ms-ribbon ms-ribbon--new">✨ New</div>
                }

                <div class="ms-card__media" id="slider-@modak.Id">
                    @for (int i = 0; i < modak.Images.Count; i++)
                    {
                        <img src="@modak.Images[i]"
                             class="ms-card__slide @(i == 0 ? "active" : "")"
                             alt="@modak.Name"
                             loading="lazy">
                    }
                    @if (modak.Images.Count > 1)
                    {
                        <button class="ms-slide-btn ms-slide-btn--prev" onclick="changeSlide(@modak.Id,-1)">&#8249;</button>
                        <button class="ms-slide-btn ms-slide-btn--next" onclick="changeSlide(@modak.Id,1)">&#8250;</button>
                        <div class="ms-slide-dots" id="dots-@modak.Id">
                            @for (int i = 0; i < modak.Images.Count; i++)
                            {
                                <span class="ms-dot @(i == 0 ? "active" : "")" onclick="goToSlide(@modak.Id,@i)"></span>
                            }
                        </div>
                    }
                    <div class="ms-card__badge">@modak.CategoryName</div>
                    <div class="ms-card__overlay"></div>
                </div>

                <div class="ms-card__body">
                    <a href="/Details?id=@modak.Id" class="ms-card__name-link">
                        <h3 class="ms-card__name">@modak.Name</h3>
                    </a>

                    @if (modak.ReviewCount > 0)
                    {
                        <div class="ms-card__rating">
                            <div class="ms-stars-row">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24"
                                         fill="@(s <= Math.Round(modak.AverageRating) ? "#c9933a" : "none")"
                                         stroke="#c9933a" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                }
                            </div>
                            <span class="ms-rating-text">@modak.AverageRating.ToString("F1") (@modak.ReviewCount)</span>
                        </div>
                    }

                    <p class="ms-card__desc">@modak.Description</p>

                    <div class="ms-pills">
                        <span class="ms-pills__label">Quick pick:</span>
                        @{
                            var u = (modak.Unit ?? "piece").ToLower();
                            bool isBulk = u.Contains("kg") || u.Contains("dozen") || u.Contains("box") || u.Contains("gm") || u.Contains("gram");
                        }
                        @if (isBulk)
                        {
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 2)">2 @modak.Unit</button>
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 3)">3 @modak.Unit</button>
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 5)">5 @modak.Unit</button>
                        }
                        else
                        {
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 6)">6x</button>
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 12)">12x</button>
                            <button class="ms-pill" onclick="setPieces(@modak.Id, 24)">24x</button>
                        }
                    </div>

                    <div class="ms-card__footer">
                        <div class="ms-price-block">
                            <span class="ms-price-unit">&#8377;</span>
                            <span class="ms-price-value" id="price-@modak.Id" data-baseprice="@modak.Price">@modak.Price</span>
                            <span class="ms-price-per">/ @modak.Unit</span>
                        </div>
                        <div class="ms-qty">
                            <button class="ms-qty__btn" onclick="changeQty(@modak.Id,-1)">&#8722;</button>
                            <input type="number" class="ms-qty__input" id="qty-@modak.Id" value="1" min="1" oninput="updatePrice(@modak.Id)">
                            <button class="ms-qty__btn" onclick="changeQty(@modak.Id,1)">+</button>
                        </div>
                    </div>

                    <div class="ms-discount-badge" id="disc-@modak.Id" style="display:none"></div>

                    <label class="ms-giftwrap">
                        <input type="checkbox" id="gift-@modak.Id" class="ms-giftwrap__check" onchange="updatePrice(@modak.Id)">
                        <span class="ms-giftwrap__box">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <polyline points="1,6 4,9 11,2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <span class="ms-giftwrap__label">&#127873; Gift wrap <span class="ms-giftwrap__price">+&#8377;50</span></span>
                    </label>

                    <div class="ms-card__actions">
                        <button class="ms-btn ms-btn--cart" onclick="addToCart('@modak.Name', @modak.Price, @modak.Id, '@modak.Unit')">
                            Add to Cart
                        </button>
                        <button onclick="orderWhatsApp('@modak.Name', @modak.Id, '@modak.Unit')" class="ms-btn ms-btn--wa">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            Order on WhatsApp
                        </button>
                    </div>
                </div>
            </article>
        }
    </main>

    <div class="ms-empty" id="emptyState" style="display:none">
        <div class="ms-empty__icon">
            <svg width="80" height="80" viewBox="0 0 100 100" fill="none">
                <ellipse cx="50" cy="68" rx="28" ry="10" fill="#c9933a" opacity="0.15"/>
                <path d="M50 88 C25 88 18 70 20 56 C22 42 32 28 50 16 C68 28 78 42 80 56 C82 70 75 88 50 88 Z" fill="#c9933a" opacity="0.9"/>
                <path d="M50 88 C25 88 18 70 20 56 C22 42 32 28 50 16 C68 28 78 42 80 56 C82 70 75 88 50 88 Z" fill="none" stroke="#7a5520" stroke-width="2"/>
                <path d="M37 34 C39 27 45 22 50 20" stroke="white" stroke-width="2.5" stroke-linecap="round" opacity="0.45"/>
                <path d="M28 62 Q50 53 72 62" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
                <path d="M25 72 Q50 63 75 72" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
                <circle cx="50" cy="16" r="6" fill="#7a5520"/>
                <circle cx="50" cy="16" r="3.5" fill="#e8b96a"/>
            </svg>
        </div>
        <p class="ms-empty__text">No modaks found for that search</p>
        <p class="ms-empty__hint">Try browsing a category:</p>
        <div class="ms-empty__suggestions" id="emptySuggestions"></div>
    </div>

    <div class="ms-pagination" id="paginationWrap" style="display:none">
        <button class="ms-page-btn" id="pagePrev" onclick="changePage(-1)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="ms-page-nums" id="pageNums"></div>
        <button class="ms-page-btn" id="pageNext" onclick="changePage(1)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
    </div>

    <section class="ms-why">
        <div class="ms-section-head" style="padding-top:0">
            <div class="ms-section-head__line"></div>
            <h2 class="ms-section-head__title">Why Choose Modak Samrat?</h2>
            <div class="ms-section-head__line"></div>
        </div>
        <div class="ms-why__grid">
            <div class="ms-why-card">
                <div class="ms-why-card__icon">🌿</div>
                <h3 class="ms-why-card__title">Premium Ingredients</h3>
                <p class="ms-why-card__text">Only the finest pure ingredients sourced fresh for every batch</p>
            </div>
            <div class="ms-why-card">
                <div class="ms-why-card__icon">📜</div>
                <h3 class="ms-why-card__title">Traditional Recipes</h3>
                <p class="ms-why-card__text">Authentic family recipes passed down through generations</p>
            </div>
            <div class="ms-why-card">
                <div class="ms-why-card__icon">👐</div>
                <h3 class="ms-why-card__title">Made on Order</h3>
                <p class="ms-why-card__text">Freshly prepared just for you — never pre-made or stored</p>
            </div>
            <div class="ms-why-card">
                <div class="ms-why-card__icon">🛡️</div>
                <h3 class="ms-why-card__title">Hygienic &amp; Safe</h3>
                <p class="ms-why-card__text">Prepared in a clean, hygienic kitchen with food-grade standards</p>
            </div>
            <div class="ms-why-card">
                <div class="ms-why-card__icon">🚚</div>
                <h3 class="ms-why-card__title">Timely Delivery</h3>
                <p class="ms-why-card__text">On-time delivery right to your doorstep across Mumbai</p>
            </div>
        </div>
    </section>

    @if (Model.FestiveEvent != null)
    {
        <section class="ms-festive">
            <div class="ms-festive__inner">
                @if (!string.IsNullOrEmpty(Model.FestiveEvent.ImagePath))
                {
                    <img src="@Model.FestiveEvent.ImagePath" class="ms-festive__img" alt="Festive" loading="lazy">
                }
                <div class="ms-festive__content">
                    <div class="ms-festive__eyebrow">🎉 Special Offer</div>
                    <h2 class="ms-festive__title">@Model.FestiveEvent.Title</h2>
                    <p class="ms-festive__desc">@Model.FestiveEvent.Description</p>
                    <div class="ms-countdown" id="countdown" data-target="@Model.FestiveEvent.EventDate.ToString("yyyy-MM-ddTHH:mm:ss")" data-title="@Html.Raw(Uri.EscapeDataString(Model.FestiveEvent.Title))">
                        <div class="ms-countdown__unit"><span class="ms-countdown__val" id="cd-days">00</span><span class="ms-countdown__label">Days</span></div>
                        <div class="ms-countdown__sep">:</div>
                        <div class="ms-countdown__unit"><span class="ms-countdown__val" id="cd-hours">00</span><span class="ms-countdown__label">Hours</span></div>
                        <div class="ms-countdown__sep">:</div>
                        <div class="ms-countdown__unit"><span class="ms-countdown__val" id="cd-mins">00</span><span class="ms-countdown__label">Mins</span></div>
                        <div class="ms-countdown__sep">:</div>
                        <div class="ms-countdown__unit"><span class="ms-countdown__val" id="cd-secs">00</span><span class="ms-countdown__label">Secs</span></div>
                    </div>
                    <button onclick="preorderWhatsApp()" class="ms-festive__btn">Pre-order Now</button>
                </div>
            </div>
        </section>
    }

    <section class="ms-testimonials">
        <div class="ms-section-head" style="padding-top:0">
            <div class="ms-section-head__line"></div>
            <h2 class="ms-section-head__title">What Customers Say</h2>
            <div class="ms-section-head__line"></div>
        </div>
        <div class="ms-testimonials__track">
            @foreach (var fb in Model.LatestFeedbacks)
            {
                <div class="ms-tcard">
                    <div class="ms-tcard__head">
                        <div class="ms-tcard__avatar">@fb.Name[0].ToString().ToUpper()</div>
                        <div>
                            <div class="ms-tcard__name">@fb.Name</div>
                            @if (!string.IsNullOrEmpty(fb.ModakName))
                            {
                                <div class="ms-tcard__modak">@fb.ModakName</div>
                            }
                        </div>
                        <div class="ms-tcard__stars">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24"
                                     fill="@(s <= fb.Rating ? "#c9933a" : "none")"
                                     stroke="#c9933a" stroke-width="2">
                                    <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                </svg>
                            }
                        </div>
                    </div>
                    <p class="ms-tcard__text">"@fb.Message"</p>
                    @if (!string.IsNullOrEmpty(fb.Occasion))
                    {
                        <div class="ms-tcard__occasion">🎉 @fb.Occasion</div>
                    }
                </div>
            }
            @if (!Model.LatestFeedbacks.Any())
            {
                <div class="ms-tcard"><p class="ms-tcard__text" style="text-align:center;color:var(--muted)">No reviews yet — be the first to share your experience!</p></div>
            }
        </div>
        <div style="text-align:center;margin-top:20px">
            <a href="/Feedback" class="ms-view-all-btn">View All Reviews &amp; Write One →</a>
        </div>
    </section>

    <section class="ms-mini-feedback">
        <div class="ms-section-head" style="padding-top:0">
            <div class="ms-section-head__line"></div>
            <h2 class="ms-section-head__title">Share Your Experience</h2>
            <div class="ms-section-head__line"></div>
        </div>
        <div class="ms-mini-feedback__inner">
            @if(Model.FeedbackSuccess){
            <div class="ms-mini-success" id="miniFeedbackSuccess">
                ✅ Thank you! Your feedback has been submitted.
            </div>
            }
            <form method="post" asp-page-handler="Feedback" class="ms-mini-form" id="miniFeedbackForm">
                <div class="ms-mini-form__row">
                    <div class="ms-mini-field">
                        <input type="text" name="FbName" class="ms-mini-input" placeholder="Your name *" required>
                    </div>
                    <div class="ms-mini-field">
                        <div class="ms-mini-select-wrap">
                            <select name="FbModak" class="ms-mini-select">
                                <option value="">Which modak? (optional)</option>
                                @foreach (var modak in Model.Modaks)
                                {
                                    <option value="@modak.Name">@modak.Name</option>
                                }
                            </select>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:var(--gold)"><path d="M6 9l6 6 6-6"/></svg>
                        </div>
                    </div>
                </div>
                <div class="ms-mini-stars" id="miniStars">
                    <input type="hidden" name="FbRating" id="miniFbRating" value="0">
                    <span class="ms-mini-stars__label">Rate us:</span>
                    @for (int i = 1; i <= 5; i++)
                    {
                        <button type="button" class="ms-mini-star" data-val="@i" onclick="setMiniRating(@i)">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c9933a" stroke-width="1.5">
                                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                            </svg>
                        </button>
                    }
                </div>
                <textarea name="FbMessage" class="ms-mini-textarea" placeholder="Tell us about your experience…" rows="3" required></textarea>
                <button type="submit" class="ms-btn ms-btn--cart" style="width:100%;margin-top:4px">
                    Submit Feedback
                </button>
            </form>
        </div>
    </section>

    <div class="wa-modal-overlay" id="waModalOverlay"></div>
    <div class="wa-modal" id="waModal">
        <h3 style="font-family:var(--font-display);font-size:22px;margin-bottom:8px;color:var(--text);">Delivery Details</h3>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">We need your location to accurately calculate delivery charges.</p>
        
        <div style="display:flex; gap:8px; margin-bottom:20px;">
            <input type="text" id="waModalInput" placeholder="Enter Pincode / Area" style="flex:1;padding:12px 14px;border:1.5px solid var(--border);border-radius:12px;font-family:var(--font-body);font-size:14px;outline:none;background:var(--card-bg);color:var(--text);">
            <button id="waModalLocBtn" onclick="useMyLocationModal()" style="padding:0 14px;background:var(--cream2);border:1.5px solid var(--border);border-radius:12px;cursor:pointer;color:var(--gold);font-size:18px;display:flex;align-items:center;justify-content:center;transition:background 0.2s;" title="Use My Location">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
