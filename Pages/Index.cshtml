.ms-testimonials{padding:0 32px 40px}
.ms-testimonials__track{display:flex;gap:20px;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.ms-testimonials__track::-webkit-scrollbar{height:4px}
.ms-testimonials__track::-webkit-scrollbar-thumb{background:var(--gold);border-radius:2px}
.ms-tcard{background:var(--card-bg);border:1px solid var(--border);border-radius:20px;padding:22px;min-width:280px;max-width:320px;flex-shrink:0;scroll-snap-align:start;box-shadow:var(--shadow)}
.ms-tcard__head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.ms-tcard__avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--gold-dim),var(--gold));color:#fff;font-family:var(--font-display);font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ms-tcard__name{font-size:13px;font-weight:700;color:var(--text)}
.ms-tcard__modak{font-size:11px;color:var(--gold);margin-top:1px}
.ms-tcard__stars{display:flex;gap:2px;margin-left:auto}
.ms-tcard__text{font-size:13px;color:var(--muted);line-height:1.7;font-style:italic;margin-bottom:10px}
