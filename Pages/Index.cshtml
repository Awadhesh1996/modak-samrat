.ms-cart-clear{width:100%;background:none;border:1px solid var(--border);border-radius:10px;padding:8px;font-size:13px;color:var(--muted);cursor:pointer;transition:all .2s}
.ms-cart-clear:hover{border-color:#e63946;color:#e63946}

.ms-float-cart{position:fixed;bottom:28px;right:28px;z-index:80;width:58px;height:58px;background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;border:none;cursor:pointer;box-shadow:0 6px 30px rgba(201,147,58,.45);transition:transform .25s,box-shadow .25s}
.ms-float-cart:hover{transform:scale(1.1) translateY(-2px);box-shadow:0 12px 40px rgba(201,147,58,.6)}
.ms-float-cart__count{position:absolute;top:-4px;right:-4px;background:#e63946;color:#fff;font-size:11px;font-weight:700;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--cream)}

.ms-footer{background:var(--ink);color:rgba(255,255,255,.4);text-align:center;padding:40px 20px}
.ms-footer__brand{font-family:var(--font-display);font-size:20px;color:var(--gold-light);margin-bottom:8px}
.ms-footer__copy{font-size:13px;letter-spacing:.05em}

body.dark .ms-cat{border-color:rgba(201,147,58,.2)}
body.dark .ms-search{color:#f0e6d3}
body.dark .ms-qty{background:rgba(255,255,255,.06)}
body.dark .ms-giftwrap__box{background:var(--cream2)}
body.dark .ms-delivery{background:var(--card-bg)}
body.dark .ms-mini-input,body.dark .ms-mini-select,body.dark .ms-mini-textarea{background:var(--cream2);color:var(--text)}

@@media(max-width:900px){.ms-festive__inner{flex-direction:column;padding:28px 24px;text-align:center}}
@@media(max-width:768px){
    .ms-nav{padding:18px 20px}
    .ms-hero{padding:28px 20px 16px}
    .ms-grid{grid-template-columns:repeat(2,1fr);gap:16px;padding:0 16px 40px}
    .ms-card__media{height:190px}
    .ms-card__body{padding:12px 14px 16px}
    .ms-card__name{font-size:15px}
    .ms-price-value{font-size:22px}
    .ms-section-head{padding:24px 20px 12px}
    .ms-delivery{padding:16px 20px}
    .ms-delivery__inner{flex-direction:column;align-items:stretch;gap:12px}
    .ms-why{padding:0 16px 40px}
    .ms-festive{margin:0 16px 40px}
    .ms-testimonials,.ms-mini-feedback{padding:0 16px 40px}
    .ms-mini-form__row{grid-template-columns:1fr}
