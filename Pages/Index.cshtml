    );
}

function executeWhatsAppRedirect(data, isCart, delivery) {
    let msg = 'Hello Modak Samrat! 🙏%0A%0A';
    let itemsTotal = 0;
    
    if (isCart) {
        msg += '*Order Summary:*%0A';
        const cart = data;
        const gross = cart.reduce((s,i) => s + i.originalTotal + (i.giftCost||0), 0);
        itemsTotal = cart.reduce((s,i) => s + i.total, 0);
        const savings = gross - itemsTotal;
        
        cart.forEach(i => {
            const discLine = i.discPct ? ` _(${i.discPct}% bulk discount)_` : '';
            const giftLine = i.giftCost ? ' + ₹50 gift wrap' : '';
            const orig = i.originalTotal + (i.giftCost||0);
            if(i.discPct) {
                msg += `• ${encodeURIComponent(i.name)} (${i.qty} ${encodeURIComponent(i.unit || '')}) = ~₹${orig}~ *₹${i.total}*${encodeURIComponent(discLine)}%0A`;
            } else {
                msg += `• ${encodeURIComponent(i.name)} (${i.qty} ${encodeURIComponent(i.unit || '')}) = *₹${i.total}*${encodeURIComponent(giftLine)}%0A`;
            }
        });
        if(savings > 0) msg += `%0A🎉 *Bulk Discount Savings: ₹${savings}*%0A`;
    } else {
        msg += '*New Order:*%0A';
        itemsTotal = data.total;
        msg += `• ${encodeURIComponent(data.name)} (${data.qty} ${encodeURIComponent(data.unit)})`;
        if (data.disc > 0) msg += ` _(${data.disc}% bulk discount)_`;
        if (data.gift) msg += ` + Gift Wrap 🎁`;
        msg += ` = *₹${data.total}*%0A`;
    }
    
    // LOGIC TO HANDLE "To be confirmed" vs "Calculated"
    let dText = '';
    let grandTotalText = '';

    if (delivery.charge === 'Custom') {
        dText = 'To be confirmed on chat';
        grandTotalText = `₹${itemsTotal} + Delivery`;
    } else {
        let actualCharge = delivery.charge;
        if(delivery.zone === 'Zone A' && itemsTotal >= 500) { actualCharge = 0; }
        const grandTotal = itemsTotal + actualCharge;
        dText = (actualCharge === 0) ? 'FREE ✅' : `₹${actualCharge}`;
        grandTotalText = `₹${grandTotal}`;
    }
    
    msg += `%0A🚚 *Delivery Details:*%0A• Location: ${encodeURIComponent(delivery.area)} (${delivery.dist}km)%0A• Charge: ${encodeURIComponent(dText)}%0A• Est. Time: ${encodeURIComponent(delivery.time)}%0A`;
    msg += `%0A⭐ *Grand Total: ${encodeURIComponent(grandTotalText)}*`;
    msg += `%0A%0APlease confirm availability. Thank you! 🙏`;
    
    window.location.href = 'https://wa.me/917021923652?text=' + msg;
}

function checkoutWhatsApp(){
    const cart=loadCart();if(!cart.length)return;
    openWaModal(cart, true);
}

function orderWhatsApp(name, id, unit) {
    const qty = document.getElementById('qty-' + id).value;
    const base = parseInt(document.getElementById('price-' + id).dataset.baseprice);
    const gift = document.getElementById('gift-' + id)?.checked;
    const disc = getDiscount(parseInt(qty));
    const orig = base * parseInt(qty);
    const discounted = Math.round(orig * (1 - disc / 100));
    const total = discounted + (gift ? 50 : 0);
    const data = { name, id, unit, qty, base, gift, disc, orig, discounted, total };
    openWaModal(data, false);
}

/* ── PAGINATION & OTHERS ──────────────── */
const PAGE_SIZE = 10;
let currentPage = 1;
let filteredCards = [];
function getVisibleCards(){return [...document.querySelectorAll('.searchable')].filter(c => c.dataset.filtered !== 'true');}
function renderPage(page){
    currentPage = page;
    const cards = filteredCards;
    const total = cards.length;
    const totalPages = Math.ceil(total / PAGE_SIZE);
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    document.querySelectorAll('.searchable').forEach(c => {c.style.display = 'none';});
    cards.forEach((c, i) => {c.style.display = (i >= start && i < end) ? '' : 'none';});
    const wrap = document.getElementById('paginationWrap');
    if(total <= PAGE_SIZE){ wrap.style.display='none'; return; }
    wrap.style.display = 'flex';
    document.getElementById('pagePrev').disabled = page <= 1;
    document.getElementById('pageNext').disabled = page >= totalPages;
    const nums = document.getElementById('pageNums');
    nums.innerHTML = '';
    const range = buildPageRange(page, totalPages);
    range.forEach(r => {
        if(r === '...'){
            const el = document.createElement('span'); el.className = 'ms-page-ellipsis'; el.textContent = '…'; nums.appendChild(el);
        } else {
            const btn = document.createElement('button'); btn.className = 'ms-page-num' + (r === page ? ' active' : ''); btn.textContent = r;
            btn.onclick = () => { renderPage(r); scrollToGrid(); }; nums.appendChild(btn);
        }
    });
}
function buildPageRange(current, total){
    if(total <= 7) return Array.from({length: total}, (_, i) => i + 1);
    const range = [];
    if(current <= 4){
        for(let i = 1; i <= Math.min(5, total); i++) range.push(i);
        if(total > 5){ range.push('...'); range.push(total); }
    } else if(current >= total - 3){
        range.push(1); range.push('...');
        for(let i = total - 4; i <= total; i++) range.push(i);
    } else {
        range.push(1); range.push('...');
        range.push(current - 1); range.push(current); range.push(current + 1);
        range.push('...'); range.push(total);
    }
    return range;
}
function changePage(dir){
    const totalPages = Math.ceil(filteredCards.length / PAGE_SIZE);
    const newPage = currentPage + dir;
    if(newPage >= 1 && newPage <= totalPages){ renderPage(newPage); scrollToGrid(); }
}
function scrollToGrid(){document.getElementById('productsGrid').scrollIntoView({behavior:'smooth', block:'start'});}
function applyFilter(matchFn){
    const allCards = [...document.querySelectorAll('.searchable')];
    filteredCards = allCards.filter(matchFn);
    allCards.forEach(c => { c.style.display='none'; c.dataset.filtered='true'; });
    filteredCards.forEach(c => { delete c.dataset.filtered; });
    const empty = document.getElementById('emptyState');
    empty.style.display = filteredCards.length === 0 ? 'block' : 'none';
    if(filteredCards.length > 0) renderPage(1);
    else document.getElementById('paginationWrap').style.display = 'none';
}
function searchProducts(){
    const q = document.getElementById('searchInput').value.toLowerCase().trim();
    if(!q){ applyFilter(() => true); return; }
    applyFilter(c => c.innerText.toLowerCase().includes(q));
    if(filteredCards.length === 0){
        const cats = [...new Set([...document.querySelectorAll('.searchable')].map(c => c.dataset.category))];
        document.getElementById('emptySuggestions').innerHTML = cats.map(c =>
            `<button class="ms-cat" onclick="filterCategory('${c}',this);document.getElementById('searchInput').value='';searchProducts()">${c}</button>`
        ).join('');
    }
}
function filterCategory(cat, btn){
    document.querySelectorAll('.ms-cat').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyFilter(c => cat === 'all' || c.dataset.category.toLowerCase() === cat.toLowerCase());
}

const cdEl=document.getElementById('countdown');
if(cdEl){
    const target=new Date(cdEl.dataset.target).getTime();
    const festiveTitle=decodeURIComponent(cdEl.dataset.title||'our%20festive%20offer');
    function updateCountdown(){
        const now=Date.now(),diff=target-now;
        if(diff<=0){
            ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id=>{ const el=document.getElementById(id); if(el)el.textContent='00'; });
            const btn=document.querySelector('.ms-festive__btn');
            if(btn){btn.textContent='Contact Us';btn.onclick=()=>window.open('https://wa.me/917021923652','_blank');}
            return;
        }
        const d=Math.floor(diff/86400000),h=Math.floor((diff%86400000)/3600000),m=Math.floor((diff%3600000)/60000),s=Math.floor((diff%60000)/1000);
        document.getElementById('cd-days').textContent=String(d).padStart(2,'0');
        document.getElementById('cd-hours').textContent=String(h).padStart(2,'0');
        document.getElementById('cd-mins').textContent=String(m).padStart(2,'0');
        document.getElementById('cd-secs').textContent=String(s).padStart(2,'0');
    }
    updateCountdown(); setInterval(updateCountdown,1000);
}
