.ms-badge__text{font-size:13px;font-weight:500;color:rgba(255,255,255,.8)}
@@keyframes badgeScroll{0%{transform:translateX(0)}100%{transform:translateX(-25%)}}

.ms-categories{padding:0 24px;margin-top:20px;overflow-x:auto}
.ms-categories::-webkit-scrollbar{display:none}
.ms-categories__track{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;padding:8px 0}
.ms-cat{padding:10px 22px;border-radius:50px;border:1.5px solid var(--border);background:var(--card-bg);color:var(--muted);font-family:var(--font-body);font-size:13px;font-weight:500;cursor:pointer;transition:all .25s;box-shadow:0 2px 12px rgba(0,0,0,.06)}
.ms-cat:hover{border-color:var(--gold);color:var(--gold)}
.ms-cat.active{background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-color:transparent;color:#fff;box-shadow:0 4px 20px rgba(201,147,58,.35)}

.ms-section-head{display:flex;align-items:center;gap:20px;padding:40px 40px 20px}
