@page
@model IndexModel

<link href="/css/bootstrap.min.css" rel="stylesheet">

<div class="main-wrapper">

    <!-- HEADER -->
    <div class="header">

        <div class="d-flex justify-content-between align-items-center">

            <div class="modaklogo">

                <img src="/images/modak.png"
                     alt="Modak"
                     class="modaklogo-icon">

                Modak Samrat

            </div>

            <div>
                <button onclick="toggleDarkMode()"
                        class="dark-btn">

                    🌙

                </button>
            </div>

        </div>

        <!-- SEARCH -->

        <div class="search-box">

            <input type="text"
                   id="searchInput"
                   placeholder="Search Modak..."
                   onkeyup="searchProducts()">

        </div>

    </div>

    <!-- CATEGORIES -->

    <div class="category-scroll">

        <div class="category-btn active"
             onclick="filterCategory('all', this)">

            All

        </div>

        @foreach (var category in Model.Categories)
        {
            <div class="category-btn"
                 onclick="filterCategory('@category.Name', this)">

                @category.Name

            </div>
        }

    </div>

    <!-- TITLE -->

    <h4 class="section-title">
        ✨ Premium Modaks
    </h4>

    <!-- PRODUCTS -->

    <div class="products-grid">

        @foreach (var modak in Model.Modaks)
        {
            <div class="product-card searchable"
                 data-category="@modak.CategoryName">

                <!-- IMAGE SLIDER -->

                <div class="slider"
                     id="slider-@modak.Id">

                    @for (int i = 0; i < modak.Images.Count; i++)
                    {
                        <img src="@modak.Images[i]"
                             class="slide @(i == 0 ? "active" : "")">
                    }

                    <button class="prev"
                            onclick="changeSlide(@modak.Id, -1)">

                        ❮

                    </button>

                    <button class="next"
                            onclick="changeSlide(@modak.Id, 1)">

                        ❯

                    </button>

                </div>

                <!-- BADGE -->

                <div class="badge-custom">
                    @modak.CategoryName
                </div>

                <!-- CONTENT -->

                <div class="product-content">

                    <!-- TITLE -->

                    <a href="/Details?id=@modak.Id"
                       class="product-title-link">

                        <div class="product-title">
                            @modak.Name
                        </div>

                    </a>

                    <!-- PRICE -->

                 <!-- PRICE -->

<div class="price"
     id="price-@modak.Id"
     data-baseprice="@modak.Price">

    ₹@modak.Price

</div>

                    <!-- DESCRIPTION -->

                    <div class="desc">
                        @modak.Description
                    </div>

                    <!-- QUANTITY -->

                    <div class="qty-box">

                        <button onclick="changeQty(@modak.Id,-1)">
                            −
                        </button>

          <input type="number"
       id="qty-@modak.Id"
       value="1"
       min="1"
       oninput="updatePrice(@modak.Id)">

                        <button onclick="changeQty(@modak.Id,1)">
                            +
                        </button>

                    </div>

                    <!-- BUTTONS -->

                    <div class="button-group">

                        <button onclick="addToCart('@modak.Name', @modak.Price, @modak.Id)">

                            Add Cart 🛒

                        </button>

                        <a href="javascript:void(0)"
                           onclick="orderWhatsApp('@modak.Name', @modak.Id)"
                           class="btn-whatsapp">

                            WhatsApp 📱

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<!-- STYLES -->

<style>

body{
    margin:0;
    background:#f4f6f9;
    font-family:'Segoe UI',sans-serif;
}

/* HEADER */

.header{

    background:
    linear-gradient(135deg,#1e293b,#0f172a);

    padding:20px;

    color:white;

    border-bottom-left-radius:25px;
    border-bottom-right-radius:25px;
}

/* LOGO */

.modaklogo{
    display:flex;
    align-items:center;
    gap:10px;

    font-size:28px;
    font-weight:bold;
}

.modaklogo-icon{
    width:42px;
    height:42px;
    object-fit:contain;
}

/* DARK BUTTON */

.dark-btn{
    background:none;
    border:none;

    color:white;

    font-size:22px;

    cursor:pointer;
}

/* SEARCH */

.search-box{
    margin-top:18px;
}

.search-box input{
    width:100%;

    padding:14px;

    border:none;
    border-radius:14px;

    font-size:15px;

    outline:none;
}

/* CATEGORY */

.category-scroll{

    overflow-x:auto;
    white-space:nowrap;

    padding:15px;
}

.category-scroll::-webkit-scrollbar{
    display:none;
}

.category-btn{

    display:inline-block;

    padding:9px 18px;

    background:#e2e8f0;

    border-radius:20px;

    margin-right:10px;

    font-size:14px;

    cursor:pointer;

    transition:0.3s;
}

.category-btn.active{
    background:#0f172a;
    color:white;
}

/* TITLE */

.section-title{
    padding:0 20px;

    margin-top:10px;

    color:#0f172a;
}

/* PRODUCTS */

.products-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(260px,1fr));

    gap:20px;

    padding:20px;
}

/* CARD */

.product-card{

    background:white;

    border-radius:20px;

    overflow:hidden;

    box-shadow:0 4px 15px rgba(0,0,0,0.08);

    position:relative;

    transition:0.3s;
}

.product-card:hover{
    transform:translateY(-5px);
}

/* BADGE */

.badge-custom{

    position:absolute;

    top:10px;
    left:10px;

    background:#0f172a;
    color:white;

    padding:5px 10px;

    border-radius:10px;

    z-index:5;

    font-size:12px;
}

/* SLIDER */
.slider{
    position:relative;
    width:100%;
    height:300px;
    overflow:hidden;
    background:#fff;
}

.slide{
    position:absolute;
    top:0;
    left:0;

    width:100%;
    height:100%;

    opacity:0;
    transition:0.5s;

    padding:10px;
    box-sizing:border-box;
}

.slide.active{
    opacity:1;
}

/* SLIDER BUTTONS */

.prev,.next{

    position:absolute;

    top:50%;

    transform:translateY(-50%);

    border:none;

    background:rgba(0,0,0,0.5);

    color:white;

    width:35px;
    height:35px;

    border-radius:50%;

    cursor:pointer;

    z-index:5;
}

.prev{
    left:10px;
}

.next{
    right:10px;
}

/* CONTENT */

.product-content{
    padding:15px;
}

/* TITLE */

.product-title-link{
    text-decoration:none;
    color:inherit;
}

.product-title{

    font-size:18px;
    font-weight:600;
}

/* PRICE */

.price{

    font-size:24px;
    font-weight:bold;

    margin-top:10px;

    color:#ff7b00;
}

/* DESC */

.desc{

    color:#64748b;

    font-size:14px;

    margin-top:10px;

    min-height:40px;
}

/* QTY */

.qty-box{

    display:flex;
    align-items:center;
    justify-content:center;

    gap:10px;

    margin-top:15px;
}

.qty-box button{

    width:35px;
    height:35px;

    border:none;

    border-radius:50%;

    background:#0f172a;
    color:white;

    cursor:pointer;
}

.qty-box input{

    width:50px;
    height:35px;

    text-align:center;

    border:1px solid #ddd;

    border-radius:8px;
}

/* BUTTONS */

.button-group{

    display:flex;
    flex-direction:column;

    gap:10px;

    margin-top:15px;
}

.button-group button,
.btn-whatsapp{

    padding:12px;

    border:none;

    border-radius:12px;

    text-align:center;

    background:
    linear-gradient(135deg,#0f172a,#1e293b);

    color:white;

    text-decoration:none;

    cursor:pointer;
}

/* DARK MODE */

.dark{
    background:#0f172a;
}

.dark .product-card{
    background:#1e293b;
}

.dark .product-title,
.dark .price,
.dark .section-title{
    color:white;
}

.dark .desc{
    color:#cbd5e1;
}

.dark input{
    background:#334155;
    color:white;
}

/* MOBILE */

@@media screen and (max-width:768px){

    .products-grid{
        grid-template-columns:1fr 1fr;
    }

    .slider{
        height:170px;
    }

}

@@media screen and (max-width:500px){

    .products-grid{
        grid-template-columns:1fr;
    }

    .modaklogo{
        font-size:22px;
    }

}

</style>

<!-- SCRIPTS -->

<script>

// DARK MODE

function toggleDarkMode(){

    document.body.classList.toggle("dark");

}

// CART

let cart = [];

function changeQty(id, change){

    let input =
    document.getElementById("qty-" + id);

    let value =
    parseInt(input.value);

    value += change;

    if(value < 1)
        value = 1;

    input.value = value;

    // UPDATE PRICE

    let priceElement =
    document.getElementById("price-" + id);

    let basePrice =
    parseInt(priceElement.dataset.baseprice);

    let totalPrice =
    basePrice * value;

    priceElement.innerHTML =
    "₹" + totalPrice;
}

function updatePrice(id){

    let qty =
    parseInt(
        document.getElementById("qty-" + id).value
    );

    if(qty < 1 || isNaN(qty))
        qty = 1;

    let priceElement =
    document.getElementById("price-" + id);

    let basePrice =
    parseInt(priceElement.dataset.baseprice);

    let totalPrice =
    basePrice * qty;

    priceElement.innerHTML =
    "₹" + totalPrice;
}

function addToCart(name, price, id){

    let qty =
    document.getElementById("qty-" + id)
    .value;

    cart.push({
        name,
        price,
        qty
    });

    alert(
        name +
        " (x" + qty + ") added to cart 🛒"
    );
}

// WHATSAPP
function orderWhatsApp(name, id){

    let qty =
    document.getElementById("qty-" + id).value;

    let priceElement =
    document.getElementById("price-" + id);

    let totalPrice =
    priceElement.innerText;

    let msg =
"Hello Modak Samrat,%0A%0A" +
"I would like to place an order.%0A%0A" +
"Product: " + name + "%0A" +
"Quantity: " + qty + "%0A" +
"Total Price: " + totalPrice + "%0A%0A" +
"Please confirm availability and delivery details.%0A%0A" +
"Thank you!";

    let url =
    "https://wa.me/917021923652?text=" + msg;

    window.open(url, "_blank");
}

// SLIDER

let sliders = {};

function changeSlide(id, direction){

    const slider =
    document.getElementById("slider-" + id);

    const slides =
    slider.getElementsByClassName("slide");

    if(!sliders[id])
        sliders[id] = 0;

    slides[sliders[id]]
    .classList
    .remove("active");

    sliders[id] += direction;

    if(sliders[id] >= slides.length)
        sliders[id] = 0;

    if(sliders[id] < 0)
        sliders[id] = slides.length - 1;

    slides[sliders[id]]
    .classList
    .add("active");
}

// AUTO SLIDE

setInterval(() => {

    document
    .querySelectorAll(".slider")
    .forEach(slider => {

        const id =
        slider.id.split("-")[1];

        changeSlide(id, 1);

    });

}, 4000);

// SEARCH

function searchProducts(){

    let input =
    document
    .getElementById("searchInput")
    .value
    .toLowerCase();

    let products =
    document.querySelectorAll(".searchable");

    products.forEach(product => {

        let text =
        product.innerText.toLowerCase();

        if(text.includes(input))
        {
            product.style.display = "block";
        }
        else
        {
            product.style.display = "none";
        }

    });

}

// CATEGORY FILTER

function filterCategory(category, element)
{
    document
    .querySelectorAll(".category-btn")
    .forEach(btn =>
        btn.classList.remove("active")
    );

    element.classList.add("active");

    let products =
    document.querySelectorAll(".searchable");

    products.forEach(product => {

        let productCategory =
        product.dataset.category;

        if(
            category.toLowerCase() === "all"
            ||
            productCategory.toLowerCase()
            === category.toLowerCase()
        )
        {
            product.style.display = "block";
        }
        else
        {
            product.style.display = "none";
        }

    });
}

</script>