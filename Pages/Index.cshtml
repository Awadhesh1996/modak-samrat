.ms-view-all-btn{display:inline-block;padding:12px 28px;border:1.5px solid var(--border);border-radius:50px;color:var(--gold);font-size:14px;font-weight:600;text-decoration:none;transition:all .2s}
.ms-view-all-btn:hover{background:var(--gold);color:#fff;border-color:var(--gold)}

.ms-mini-feedback{padding:0 32px 60px}
.ms-mini-feedback__inner{background:var(--card-bg);border:1px solid var(--border);border-radius:24px;padding:32px;max-width:700px;margin:0 auto;box-shadow:var(--shadow)}
.ms-mini-form__row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px}
.ms-mini-field{position:relative}
.ms-mini-input{width:100%;padding:13px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;font-family:var(--font-body);color:var(--text);background:var(--cream);outline:none;transition:border-color .2s}
.ms-mini-input:focus{border-color:var(--gold);background:#fff}
.ms-mini-input::placeholder{color:#c4b09a}
.ms-mini-select-wrap{position:relative}
.ms-mini-select{width:100%;padding:13px 36px 13px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;font-family:var(--font-body);color:var(--text);background:var(--cream);outline:none;appearance:none;cursor:pointer}
