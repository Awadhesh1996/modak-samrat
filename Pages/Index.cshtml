.ms-mini-star:hover{transform:scale(1.2)}
.ms-mini-star.active svg{fill:var(--gold)}
.ms-mini-textarea{width:100%;padding:13px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;font-family:var(--font-body);color:var(--text);background:var(--cream);outline:none;resize:vertical;line-height:1.6;margin-bottom:4px;transition:border-color .2s}
.ms-mini-textarea:focus{border-color:var(--gold);background:#fff}
.ms-mini-textarea::placeholder{color:#c4b09a}
.ms-mini-success{background:rgba(37,160,102,.1);border:1px solid rgba(37,160,102,.25);color:#1e6b4a;padding:16px;border-radius:12px;font-weight:600;font-size:14px;text-align:center;margin-bottom:16px}

/* WHATSAPP LOCATION POPUP */
.wa-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; backdrop-filter: blur(3px); }
.wa-modal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--card-bg); width: 90%; max-width: 360px; padding: 24px; border-radius: 20px; z-index: 1001; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
.wa-modal.show, .wa-modal-overlay.show { display: block; }

/* CART DRAWER */
.ms-cart-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:90;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(4px)}
.ms-cart-backdrop.open{opacity:1;pointer-events:all}
.ms-cart-drawer{position:fixed;top:0;right:0;width:min(400px,100vw);height:100vh;background:var(--card-bg);z-index:100;transform:translateX(100%);transition:transform .4s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column;box-shadow:-10px 0 60px rgba(0,0,0,.2)}
.ms-cart-drawer.open{transform:translateX(0)}
.ms-cart-drawer__head{display:flex;justify-content:space-between;align-items:center;padding:24px;border-bottom:1px solid var(--border)}
.ms-cart-drawer__head h3{font-family:var(--font-display);font-size:22px;color:var(--text)}
.ms-cart-close{background:none;border:none;font-size:20px;cursor:pointer;color:var(--muted);width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
.ms-cart-close:hover{background:var(--cream2)}
.ms-cart-drawer__items{flex:1;overflow-y:auto;padding:16px 24px}
.ms-cart-empty{text-align:center;color:var(--muted);padding:60px 0;font-size:15px}
.ms-cart-item{padding:14px 0;border-bottom:1px solid rgba(201,147,58,.08)}
.ms-cart-item__name{font-weight:600;font-size:14px;color:var(--text);margin-bottom:4px}
.ms-cart-item__meta{font-size:12px;color:var(--muted)}
.ms-cart-item__price-row{display:flex;align-items:center;gap:8px;margin-top:4px}
.ms-cart-item__original{font-size:12px;color:var(--muted);text-decoration:line-through}
.ms-cart-item__final{font-family:var(--font-display);font-weight:700;color:var(--gold);font-size:16px}
.ms-cart-item__disc{font-size:11px;background:rgba(37,160,102,.15);color:#1e6b4a;padding:2px 8px;border-radius:50px;font-weight:600}
.ms-cart-item__footer { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 12px; }
.ms-cart-qty { display: flex; align-items: center; gap: 6px; background: var(--cream2); border: 1px solid var(--border); border-radius: 50px; padding: 2px; }
.ms-cart-qty button { width: 26px; height: 26px; border-radius: 50%; border: none; background: var(--card-bg); color: var(--text); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.1); font-size: 15px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.ms-cart-qty button:hover { background: var(--gold); color: #fff; }
.ms-cart-qty span { font-size: 14px; font-weight: 600; min-width: 24px; text-align: center; color: var(--text); }
.ms-cart-item__remove { background: none; border: none; color: var(--muted); font-size: 15px; cursor: pointer; padding: 0 4px; transition: color .2s; line-height: 1; }
.ms-cart-item__remove:hover { color: var(--danger); }

.ms-cart-drawer__foot{padding:20px 24px;border-top:1px solid var(--border)}
.ms-cart-total{margin-bottom:16px}
.ms-cart-total__row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:4px}
.ms-cart-total__savings{font-size:12px;color:#1e6b4a;font-weight:600;background:rgba(37,160,102,.1);padding:6px 12px;border-radius:8px;margin-bottom:10px;text-align:center}
.ms-cart-total__final{display:flex;justify-content:space-between;font-size:16px;font-weight:700;color:var(--text)}
