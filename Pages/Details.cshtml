@page
@model DetailsModel

@{
    ViewData["Title"] = Model.Modak.Name + " – Modak Samrat";
}

<meta name="description" content="@Model.Modak.Description">
<meta property="og:title" content="@Model.Modak.Name – Modak Samrat">
<meta property="og:image" content="@Model.Modak.Images.FirstOrDefault()">

<div class="dp-root" id="dpRoot">

    <!-- ══════════════════════════════════
         STICKY NAV
    ══════════════════════════════════ -->
    <nav class="dp-nav">
        <a href="/" class="dp-back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            <span>Back to Store</span>
        </a>
        <div class="dp-nav__logo">Modak Samrat</div>
        <div class="dp-nav__right">
            <button class="dp-nav__cart" onclick="toggleCart()" title="View Cart" aria-label="Open cart">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                <span class="dp-nav__cart-count" id="cartCount" style="display:none">0</span>
            </button>
            <button onclick="orderWhatsApp()" class="dp-nav__wa">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span>Order Now</span>
            </button>
        </div>
    </nav>

    <!-- ══════════════════════════════════
         MAIN LAYOUT
    ══════════════════════════════════ -->
    <div class="dp-main">

        <!-- GALLERY -->
        <div class="dp-gallery">
            <div class="dp-gallery__main">
                <img id="mainImg" src="@Model.Modak.Images.FirstOrDefault()" alt="@Model.Modak.Name" class="dp-gallery__main-img" loading="eager">
                <div class="dp-gallery__main-overlay"></div>
                <div class="dp-gallery__badge">@Model.Modak.CategoryName</div>
                @if (Model.Modak.Images.Count > 1)
                {
                    <button class="dp-arrow dp-arrow--prev" onclick="changeMain(-1)">&#8249;</button>
                    <button class="dp-arrow dp-arrow--next" onclick="changeMain(1)">&#8250;</button>
                }
                <div class="dp-zoom-hint">Hover to zoom</div>
            </div>

            @if (Model.Modak.Images.Count > 1)
            {
                <div class="dp-thumbs">
                    @for (int i = 0; i < Model.Modak.Images.Count; i++)
                    {
                        <div class="dp-thumb @(i == 0 ? "active" : "")" onclick="setMain('@Model.Modak.Images[i]', this, @i)">
                            <img src="@Model.Modak.Images[i]" alt="View @(i+1)" loading="lazy">
                        </div>
                    }
                </div>
            }
        </div>

        <!-- ══════════════════════════════
             INFO PANEL
        ══════════════════════════════ -->
        <div class="dp-info">

            <div class="dp-chip">@Model.Modak.CategoryName</div>
            <h1 class="dp-name">@Model.Modak.Name</h1>

            <!-- STAR RATING -->
            @if (Model.ReviewCount > 0)
            {
                <div class="dp-rating">
                    <div class="dp-rating__stars">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24"
                                 fill="@(s <= Math.Round(Model.AverageRating) ? "#c9933a" : "none")"
                                 stroke="#c9933a" stroke-width="2">
                                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                            </svg>
                        }
                    </div>
                    <span class="dp-rating__score">@Model.AverageRating.ToString("F1")</span>
                    <span class="dp-rating__count">(@Model.ReviewCount review@(Model.ReviewCount != 1 ? "s" : ""))</span>
                    <a href="#dp-reviews" class="dp-rating__link">See all reviews</a>
                </div>
            }
            else
            {
                <div class="dp-rating dp-rating--none">
                    <span>No reviews yet</span>
                    <a href="/Feedback" class="dp-rating__link">Be the first to review</a>
                </div>
            }

            <div class="dp-divider">
                <div class="dp-divider__line"></div>
                <span class="dp-divider__ornament">&#10022;</span>
                <div class="dp-divider__line"></div>
            </div>

            <!-- PRICE WITH DYNAMIC UNIT -->
            <div class="dp-price-row">
                <div class="dp-price">
                    <span class="dp-price__symbol">&#8377;</span>
                    <span class="dp-price__value" id="detailPrice" data-baseprice="@Model.Modak.Price">@Model.Modak.Price</span>
                </div>
                <div class="dp-price__note">/ @Model.Modak.Unit</div>
            </div>

            <!-- DISCOUNT BANNER -->
            <div class="dp-disc-banner" id="discBanner" style="display:none"></div>

            <!-- DESC -->
            <p class="dp-desc">@Model.Modak.Description</p>

            <!-- FEATURES -->
            <div class="dp-features">
                <div class="dp-feature"><span>&#127807;</span><span>Pure Ingredients</span></div>
                <div class="dp-feature"><span>&#128830;</span><span>Traditional Recipe</span></div>
                <div class="dp-feature"><span>&#128666;</span><span>Fresh Delivery</span></div>
            </div>

            <!-- QUICK PICK PILLS -->
            <div class="dp-section-label">Quick Pick</div>
            <div class="dp-pills">
                @{
                    var uDetails = (Model.Modak.Unit ?? "piece").ToLower();
                    bool isBulkDetails = uDetails.Contains("kg") || uDetails.Contains("dozen") || uDetails.Contains("box") || uDetails.Contains("gm") || uDetails.Contains("gram");
                }
                @if (isBulkDetails)
                {
                    <button class="dp-pill" onclick="setPieces(2, this)">2 @Model.Modak.Unit</button>
                    <button class="dp-pill" onclick="setPieces(3, this)">3 @Model.Modak.Unit</button>
                    <button class="dp-pill" onclick="setPieces(5, this)">5 @Model.Modak.Unit</button>
                }
                else
                {
                    <button class="dp-pill" onclick="setPieces(6, this)">6x</button>
                    <button class="dp-pill" onclick="setPieces(12, this)">12x</button>
                    <button class="dp-pill" onclick="setPieces(24, this)">24x</button>
                }
            </div>

            <!-- QTY -->
            <div class="dp-qty-section">
                <div class="dp-section-label">Quantity</div>
                <div class="dp-qty-row">
                    <div class="dp-qty">
                        <button class="dp-qty__btn" onclick="changeQty(-1)">&#8722;</button>
                        <input type="number" id="qty" class="dp-qty__input" value="1" min="1" oninput="syncPrice()">
                        <button class="dp-qty__btn" onclick="changeQty(1)">+</button>
                    </div>
                    <div class="dp-qty-total">
                        Total: <strong id="qtyTotal">&#8377;@Model.Modak.Price</strong>
                    </div>
                </div>
            </div>

            <!-- GIFT WRAP -->
            <label class="dp-giftwrap">
                <input type="checkbox" id="giftWrap" class="dp-giftwrap__check" onchange="syncPrice()">
                <span class="dp-giftwrap__box">
                    <svg width="13" height="13" viewBox="0 0 12 12" fill="none">
                        <polyline points="1,6 4,9 11,2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <div class="dp-giftwrap__content">
                    <span class="dp-giftwrap__label">&#127873; Add festive gift wrap</span>
                    <span class="dp-giftwrap__sub">Beautiful box with ribbon — perfect for Diwali, weddings &amp; poojas</span>
                </div>
                <span class="dp-giftwrap__price">+&#8377;50</span>
            </label>

            <!-- INGREDIENTS ACCORDION -->
            <div class="dp-accordion">
                <button class="dp-accordion__btn" onclick="toggleAccordion('ingredients')">
                    <span>&#127981; Ingredients &amp; Allergens</span>
                    <svg class="dp-accordion__icon" id="icon-ingredients" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="dp-accordion__body" id="ingredients">
                    <p class="dp-accordion__text">Made with: Pure khoya, fresh coconut, jaggery, cardamom, saffron, rice flour, and desi ghee.</p>
                    <div class="dp-allergen-chips">
                        <span class="dp-allergen">&#127997; Contains Dairy</span>
                        <span class="dp-allergen">&#127807; Gluten-Free</span>
                        <span class="dp-allergen">&#127812; Nut-Free Option Available</span>
                    </div>
                </div>

                <button class="dp-accordion__btn" onclick="toggleAccordion('storage')" style="border-top:1px solid rgba(201,147,58,.1)">
                    <span>&#128336; Shelf Life &amp; Storage</span>
                    <svg class="dp-accordion__icon" id="icon-storage" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="dp-accordion__body" id="storage">
                    <p class="dp-accordion__text">Best consumed within <strong>3 days</strong> of delivery. Store in a cool, dry place. Refrigerate in an airtight container to extend freshness up to 5 days.</p>
                </div>

                <!-- UPDATED WEIGHT ACCORDION -->
                <button class="dp-accordion__btn" onclick="toggleAccordion('weight')" style="border-top:1px solid rgba(201,147,58,.1)">
                    <span>&#9881; Weight &amp; Serving</span>
                    <svg class="dp-accordion__icon" id="icon-weight" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="dp-accordion__body" id="weight">
                    <p class="dp-accordion__text">Carefully measured and packed according to your selected unit (<strong>@Model.Modak.Unit</strong>). Hand-shaped by our artisans ensuring consistent premium quality.</p>
                </div>
            </div>

            <!-- CTA BUTTONS -->
            <div class="dp-cta">
                <button class="dp-btn dp-btn--cart" onclick="addToCart()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                    Add to Cart
                </button>
                <button onclick="orderWhatsApp()" class="dp-btn dp-btn--wa">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Order on WhatsApp
                </button>
            </div>

            <div class="dp-toast" id="toast" style="visibility:hidden;transform:translateX(-50%) translateY(80px)">&#10003; Added to cart</div>
        </div>
    </div>

    <!-- ══════════════════════════════════
         CUSTOMER REVIEWS
    ══════════════════════════════════ -->
    <section class="dp-reviews" id="dp-reviews">
        <div class="dp-reviews__head">
            <div class="dp-reviews__line"></div>
            <h2 class="dp-reviews__title">Customer Reviews</h2>
            <div class="dp-reviews__line"></div>
        </div>

        @if (Model.Feedbacks.Any())
        {
            <div class="dp-reviews__summary">
                <div class="dp-reviews__score">@Model.AverageRating.ToString("F1")</div>
                <div class="dp-reviews__summary-right">
                    <div class="dp-reviews__stars">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24"
                                 fill="@(s <= Math.Round(Model.AverageRating) ? "#c9933a" : "none")"
                                 stroke="#c9933a" stroke-width="2">
                                <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                            </svg>
                        }
                    </div>
                    <div class="dp-reviews__count">Based on @Model.ReviewCount review@(Model.ReviewCount != 1 ? "s" : "")</div>
                </div>
                <a href="/Feedback" class="dp-reviews__write-btn">Write a Review</a>
            </div>

            <div class="dp-reviews__list">
                @foreach (var fb in Model.Feedbacks)
                {
                    <div class="dp-review-card">
                        <div class="dp-review-card__head">
                            <div class="dp-review-card__avatar">@fb.Name[0].ToString().ToUpper()</div>
                            <div class="dp-review-card__meta">
                                <div class="dp-review-card__name">@fb.Name</div>
                                @if (!string.IsNullOrEmpty(fb.Occasion))
                                {
                                    <div class="dp-review-card__occasion">&#127881; @fb.Occasion</div>
                                }
                            </div>
                            <div class="dp-review-card__stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24"
                                         fill="@(s <= fb.Rating ? "#c9933a" : "none")"
                                         stroke="#c9933a" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(fb.Tags))
                        {
                            <div class="dp-review-card__tags">
                                @foreach (var tag in fb.Tags.Split(','))
                                {
                                    <span class="dp-review-card__tag">@tag.Trim()</span>
                                }
                            </div>
                        }
                        <p class="dp-review-card__text">"@fb.Message"</p>
                        <div class="dp-review-card__date">@fb.CreatedAt.ToString("MMM dd, yyyy")</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dp-reviews__empty">
                <p>No reviews yet for this modak.</p>
                <a href="/Feedback" class="dp-reviews__write-btn" style="display:inline-flex;margin-top:12px">Be the first to review &#8594;</a>
            </div>
        }
    </section>

    <!-- ═══════════════════════════════════════
         RELATED MODAKS
    ═══════════════════════════════════════ -->
    @if (Model.RelatedModaks.Count > 0)
    {
        <section class="dp-related">
            <div class="dp-related__head">
                <div class="dp-related__line"></div>
                <h2 class="dp-related__title">You May Also Like</h2>
                <div class="dp-related__line"></div>
            </div>
            <div class="dp-related__grid">
                @foreach (var item in Model.RelatedModaks)
                {
                    <a href="/Details?id=@item.Id" class="dp-related-card">
                        <div class="dp-related-card__img-wrap">
                            <img src="@item.Images.FirstOrDefault()" alt="@item.Name" class="dp-related-card__img" loading="lazy">
                            <div class="dp-related-card__overlay"></div>
                        </div>
                        <div class="dp-related-card__body">
                            <div class="dp-related-card__name">@item.Name</div>
                            @if (item.ReviewCount > 0)
                            {
                                <div class="dp-related-card__rating">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="#c9933a" stroke="#c9933a" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                    <span>@item.AverageRating.ToString("F1")</span>
                                </div>
                            }
                            <div class="dp-related-card__price">&#8377;@item.Price</div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- LOCATION POPUP MODAL -->
    <div class="wa-modal-overlay" id="waModalOverlay"></div>
    <div class="wa-modal" id="waModal">
        <h3 style="font-family:var(--font-display);font-size:22px;margin-bottom:8px;color:var(--text);">Delivery Details</h3>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px;">We need your location to accurately calculate delivery charges.</p>
        
        <div style="display:flex; gap:8px; margin-bottom:20px;">
            <input type="text" id="waModalInput" placeholder="Enter Pincode / Area" style="flex:1;padding:12px 14px;border:1.5px solid var(--border);border-radius:12px;font-family:var(--font-body);font-size:14px;outline:none;background:var(--card-bg);color:var(--text);">
            <button id="waModalLocBtn" onclick="useMyLocationModal()" style="padding:0 14px;background:var(--cream2);border:1.5px solid var(--border);border-radius:12px;cursor:pointer;color:var(--gold);font-size:18px;display:flex;align-items:center;justify-content:center;transition:background 0.2s;" title="Use My Location">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
            </button>
        </div>
        
        <div style="display:flex;justify-content:flex-end;gap:10px;">
            <button onclick="closeWaModal()" style="padding:10px 16px;background:none;border:1px solid var(--border);border-radius:10px;cursor:pointer;color:var(--muted);font-weight:600;">Cancel</button>
            <button id="waModalSubmitBtn" onclick="submitWaModal()" style="padding:10px 20px;background:var(--gold);border:none;border-radius:10px;cursor:pointer;color:#fff;font-weight:600;">Order</button>
        </div>
    </div>

    <!-- CART DRAWER -->
    <div class="dp-cart-backdrop" id="cartBackdrop" onclick="toggleCart()"></div>
    <aside class="dp-cart-drawer" id="cartDrawer">
        <div class="dp-cart-drawer__head">
            <h3>Your Cart</h3>
            <button onclick="toggleCart()" class="dp-cart-close">&#10005;</button>
        </div>
        <div class="dp-cart-drawer__items" id="cartItems">
            <div class="dp-cart-empty">Your cart is empty &#128722;</div>
        </div>
        <div class="dp-cart-drawer__foot" id="cartFoot" style="display:none">
            <div id="cartTotalWrap"></div>
            <button class="dp-btn dp-btn--cart" style="width:100%;margin-bottom:10px" onclick="checkoutWhatsApp()">
                Checkout on WhatsApp &#128241;
            </button>
            <button class="dp-cart-clear" onclick="clearCart()">Clear cart</button>
        </div>
    </aside>

    <button class="dp-float-cart" onclick="toggleCart()" title="View Cart" aria-label="Open cart">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <span class="dp-float-cart__count" id="floatCartCount" style="display:none">0</span>
    </button>

    <!-- FOOTER -->
    <footer class="dp-footer">
        <div class="dp-footer__brand">Modak Samrat</div>
        <p class="dp-footer__copy">Handcrafted with love &middot; Pure ingredients &middot; Ancient recipes</p>
    </footer>

</div>

<style>
:root{--gold:#c9933a;--gold-light:#e8b96a;--gold-dim:#7a5520;--ink:#1a1208;--cream:#fdf6ec;--cream2:#f5ead8;--card-bg:#ffffff;--text:#2d1f0e;--muted:#8b7355;--border:rgba(201,147,58,.18);--radius:20px;--shadow:0 8px 40px rgba(0,0,0,.10);--font-display:'Playfair Display',Georgia,serif;--font-body:'DM Sans',sans-serif;--font-italic:'Cormorant Garamond',Georgia,serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--cream);font-family:var(--font-body);color:var(--text);min-height:100vh}

/* NAV */
.dp-nav{display:flex;align-items:center;justify-content:space-between;padding:18px 36px;background:var(--ink);position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(201,147,58,.2)}
.dp-back{display:flex;align-items:center;gap:8px;color:rgba(255,255,255,.7);text-decoration:none;font-size:14px;font-weight:500;transition:color .2s}
.dp-back:hover{color:var(--gold)}
.dp-nav__logo{font-family:var(--font-display);font-size:18px;font-weight:700;color:var(--gold-light);letter-spacing:.03em}
.dp-nav__right{display:flex;align-items:center;gap:14px}
.dp-nav__cart{position:relative;background:transparent;border:none;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:rgba(255,255,255,.8);transition:all .2s;font-family:var(--font-body)}
.dp-nav__cart:hover{background:rgba(201,147,58,.2)}
.dp-nav__cart-count{position:absolute;top:-4px;right:-4px;background:#e63946;color:#fff;font-size:9px;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--ink)}
.dp-nav__wa{display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,#128c7e,#25d366);color:#fff;text-decoration:none;font-size:13px;font-weight:600;padding:9px 16px;border-radius:50px;transition:all .25s;box-shadow:0 4px 16px rgba(37,211,102,.3);border:none;cursor:pointer;font-family:var(--font-body);white-space:nowrap}
.dp-nav__wa:hover{transform:translateY(-1px)}

/* MAIN */
.dp-main{display:grid;grid-template-columns:1fr 1fr;gap:60px;max-width:1300px;margin:0 auto;padding:50px 40px;align-items:start}

/* GALLERY */
.dp-gallery{position:sticky;top:80px}
.dp-gallery__main{position:relative;border-radius:24px;overflow:hidden;background:var(--cream2);aspect-ratio:1;box-shadow:0 20px 60px rgba(0,0,0,.12);cursor:zoom-in}
.dp-gallery__main-img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease;display:block}
.dp-gallery__main:hover .dp-gallery__main-img{transform:scale(1.06)}
.dp-gallery__main-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(26,18,8,.35) 0%,transparent 40%);pointer-events:none}
.dp-gallery__badge{position:absolute;bottom:20px;left:20px;background:rgba(201,147,58,.92);backdrop-filter:blur(8px);color:#fff;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:7px 16px;border-radius:50px}
.dp-zoom-hint{position:absolute;bottom:20px;right:20px;font-size:11px;color:rgba(255,255,255,.5)}
.dp-arrow{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.4);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.15);color:#fff;width:42px;height:42px;border-radius:50%;font-size:24px;cursor:pointer;z-index:10;transition:all .2s;display:flex;align-items:center;justify-content:center;opacity:0}
.dp-gallery__main:hover .dp-arrow{opacity:1}
.dp-arrow:hover{background:rgba(201,147,58,.7)}
.dp-arrow--prev{left:14px}.dp-arrow--next{right:14px}
.dp-thumbs{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
.dp-thumb{width:80px;height:80px;border-radius:14px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:all .25s;flex-shrink:0}
.dp-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .3s}
.dp-thumb:hover img{transform:scale(1.08)}
.dp-thumb.active{border-color:var(--gold);box-shadow:0 0 0 2px rgba(201,147,58,.3)}

/* INFO */
.dp-info{padding-top:10px}
.dp-chip{display:inline-block;background:linear-gradient(135deg,var(--gold-dim),var(--gold));color:#fff;font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;padding:6px 16px;border-radius:50px;margin-bottom:16px;box-shadow:0 4px 16px rgba(201,147,58,.3)}
.dp-name{font-family:var(--font-display);font-size:clamp(28px,4vw,48px);font-weight:900;color:var(--text);line-height:1.05;letter-spacing:-.02em;margin-bottom:14px}

/* RATING */
.dp-rating{display:flex;align-items:center;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.dp-rating__stars{display:flex;gap:3px}
.dp-rating__score{font-family:var(--font-display);font-size:18px;font-weight:700;color:var(--gold)}
.dp-rating__count{font-size:13px;color:var(--muted)}
.dp-rating__link{font-size:12px;color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(201,147,58,.3);margin-left:4px}
.dp-rating__link:hover{border-color:var(--gold)}
.dp-rating--none{font-size:13px;color:var(--muted)}

/* DIVIDER */
.dp-divider{display:flex;align-items:center;gap:14px;margin-bottom:24px}
.dp-divider__line{flex:1;height:1px;background:linear-gradient(90deg,rgba(201,147,58,.4),transparent)}
.dp-divider__ornament{color:var(--gold);font-size:12px}

/* PRICE */
.dp-price-row{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}
.dp-price{display:flex;align-items:baseline;gap:2px}
.dp-price__symbol{font-size:22px;font-weight:600;color:var(--gold)}
.dp-price__value{font-family:var(--font-display);font-size:48px;font-weight:900;color:var(--gold);line-height:1}
.dp-price__note{font-size:13px;color:var(--muted);align-self:flex-end;padding-bottom:6px}

/* DISCOUNT BANNER */
.dp-disc-banner{background:linear-gradient(135deg,#1e6b4a,#25a066);color:#fff;font-size:12px;font-weight:700;padding:8px 16px;border-radius:10px;margin-bottom:14px;letter-spacing:.03em}
.dp-desc{font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:22px;font-weight:300}

/* FEATURES */
.dp-features{display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap}
.dp-feature{display:flex;align-items:center;gap:7px;background:var(--cream2);border:1px solid var(--border);border-radius:50px;padding:7px 14px;font-size:12px;color:var(--muted);font-weight:500}

/* SECTION LABEL */
.dp-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}

/* PILLS */
.dp-pills{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.dp-pill{padding:8px 18px;border-radius:50px;border:1.5px solid var(--border);background:transparent;color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font-body);transition:all .2s}
.dp-pill:hover,.dp-pill.active{background:var(--gold);border-color:var(--gold);color:#fff;box-shadow:0 4px 16px rgba(201,147,58,.3)}

/* QTY */
.dp-qty-section{margin-bottom:18px}
.dp-qty-row{display:flex;align-items:center;justify-content:space-between}
.dp-qty{display:flex;align-items:center;background:var(--cream2);border:1.5px solid var(--border);border-radius:50px;overflow:hidden;gap:4px;padding:4px}
.dp-qty__btn{width:40px;height:40px;border:none;background:var(--card-bg);border-radius:50%;font-size:20px;cursor:pointer;color:var(--text);display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.08);transition:all .2s;line-height:1}
.dp-qty__btn:hover{background:var(--gold);color:#fff}
.dp-qty__input{width:50px;text-align:center;border:none;background:transparent;font-size:18px;font-weight:700;color:var(--text);font-family:var(--font-display);outline:none}
.dp-qty-total{font-size:14px;color:var(--muted)}
.dp-qty-total strong{font-family:var(--font-display);font-size:22px;font-weight:700;color:var(--text);display:block}

/* GIFT WRAP */
.dp-giftwrap{display:flex;align-items:flex-start;gap:12px;background:linear-gradient(135deg,rgba(201,147,58,.06),rgba(201,147,58,.02));border:1.5px solid rgba(201,147,58,.2);border-radius:16px;padding:16px;cursor:pointer;margin-bottom:24px;user-select:none;transition:border-color .2s}
.dp-giftwrap:hover{border-color:var(--gold)}
.dp-giftwrap__check{display:none}
.dp-giftwrap__box{width:22px;height:22px;border-radius:7px;border:1.5px solid rgba(201,147,58,.4);background:var(--card-bg);display:flex;align-items:center;justify-content:center;color:transparent;transition:all .2s;flex-shrink:0;margin-top:2px}
.dp-giftwrap__check:checked + .dp-giftwrap__box{background:var(--gold);border-color:var(--gold);color:#fff}
.dp-giftwrap__content{flex:1}
.dp-giftwrap__label{display:block;font-size:14px;font-weight:600;color:var(--text);margin-bottom:3px}
.dp-giftwrap__sub{display:block;font-size:12px;color:var(--muted);line-height:1.5}
.dp-giftwrap__price{font-family:var(--font-display);font-size:18px;font-weight:700;color:var(--gold);flex-shrink:0;align-self:center}

/* ACCORDION */
.dp-accordion{border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:24px}
.dp-accordion__btn{width:100%;display:flex;align-items:center;justify-content:space-between;padding:15px 18px;background:none;border:none;font-family:var(--font-body);font-size:14px;font-weight:600;color:var(--text);cursor:pointer;text-align:left;transition:background .2s}
.dp-accordion__btn:hover{background:rgba(201,147,58,.05)}
.dp-accordion__icon{transition:transform .3s;flex-shrink:0;color:var(--gold)}
.dp-accordion__icon.open{transform:rotate(180deg)}
.dp-accordion__body{max-height:0;overflow:hidden;transition:max-height .4s ease,padding .3s}
.dp-accordion__body.open{max-height:200px;padding:0 18px 16px}
.dp-accordion__text{font-size:13px;color:var(--muted);line-height:1.7;margin-bottom:10px}
.dp-allergen-chips{display:flex;gap:8px;flex-wrap:wrap}
.dp-allergen{font-size:11px;background:var(--cream2);border:1px solid var(--border);color:var(--muted);padding:4px 12px;border-radius:50px}

/* CTA */
.dp-cta{display:flex;flex-direction:column;gap:12px;position:relative}
.dp-btn{display:flex;align-items:center;justify-content:center;gap:10px;padding:17px 24px;border:none;border-radius:16px;font-size:15px;font-weight:600;font-family:var(--font-body);cursor:pointer;text-decoration:none;transition:all .3s;letter-spacing:.02em}
.dp-btn--cart{background:linear-gradient(135deg,#1a1208,#3d2410);color:#fff;box-shadow:0 6px 24px rgba(26,18,8,.25)}
.dp-btn--cart:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(26,18,8,.35);background:linear-gradient(135deg,#2d1a05,var(--gold-dim))}
.dp-btn--wa{background:linear-gradient(135deg,#128c7e,#25d366);color:#fff;box-shadow:0 6px 24px rgba(37,211,102,.2);border:none;cursor:pointer;font-family:var(--font-body)}
.dp-btn--wa:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(37,211,102,.35)}

/* TOAST */
.dp-toast{position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(80px);background:#1a1208;color:#fff;padding:14px 28px;border-radius:50px;font-size:14px;font-weight:600;border-left:3px solid var(--gold);box-shadow:0 8px 30px rgba(0,0,0,.3);transition:transform .4s cubic-bezier(.22,.61,.36,1);z-index:200;white-space:nowrap}
.dp-toast.show{transform:translateX(-50%) translateY(0)}

/* WHATSAPP LOCATION POPUP */
.wa-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; backdrop-filter: blur(3px); }
.wa-modal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--card-bg); width: 90%; max-width: 360px; padding: 24px; border-radius: 20px; z-index: 1001; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
.wa-modal.show, .wa-modal-overlay.show { display: block; }

/* REVIEWS */
.dp-reviews{max-width:1300px;margin:0 auto;padding:20px 40px 60px}
.dp-reviews__head{display:flex;align-items:center;gap:20px;margin-bottom:28px}
.dp-reviews__line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(201,147,58,.3),transparent)}
.dp-reviews__title{font-family:var(--font-display);font-size:13px;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);white-space:nowrap}
.dp-reviews__summary{display:flex;align-items:center;gap:20px;background:var(--card-bg);border:1px solid var(--border);border-radius:18px;padding:24px 28px;margin-bottom:24px;box-shadow:var(--shadow)}
.dp-reviews__score{font-family:var(--font-display);font-size:52px;font-weight:900;color:var(--gold);line-height:1}
.dp-reviews__summary-right{flex:1}
.dp-reviews__stars{display:flex;gap:4px;margin-bottom:6px}
.dp-reviews__count{font-size:13px;color:var(--muted)}
.dp-reviews__write-btn{display:inline-flex;align-items:center;padding:10px 22px;background:linear-gradient(135deg,var(--ink),#3d2410);color:#fff;border-radius:50px;font-size:13px;font-weight:600;text-decoration:none;transition:all .25s;margin-left:auto}
.dp-reviews__write-btn:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(26,18,8,.25)}
.dp-reviews__list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.dp-reviews__empty{text-align:center;padding:48px;color:var(--muted);font-size:15px}
.dp-review-card{background:var(--card-bg);border:1px solid var(--border);border-radius:16px;padding:20px;box-shadow:0 2px 16px rgba(0,0,0,.06)}
.dp-review-card__head{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}
.dp-review-card__avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--gold-dim),var(--gold));color:#fff;font-family:var(--font-display);font-size:16px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.dp-review-card__name{font-size:14px;font-weight:700;color:var(--text);margin-bottom:2px}
.dp-review-card__occasion{font-size:11px;color:var(--muted)}
.dp-review-card__stars{display:flex;gap:2px;margin-left:auto;flex-shrink:0}
.dp-review-card__tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.dp-review-card__tag{font-size:10px;padding:3px 10px;background:var(--cream2);border:1px solid var(--border);border-radius:50px;color:var(--muted)}
.dp-review-card__text{font-size:13px;color:var(--muted);line-height:1.7;font-style:italic;margin-bottom:14px}
.dp-review-card__foot{display:flex;justify-content:space-between;align-items:center}
.dp-review-card__date{font-size:11px;color:var(--muted)}

/* RELATED */
.dp-related{max-width:1300px;margin:0 auto;padding:0 40px 60px}
.dp-related__head{display:flex;align-items:center;gap:20px;margin-bottom:24px}
.dp-related__line{flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(201,147,58,.3),transparent)}
.dp-related__title{font-family:var(--font-display);font-size:13px;font-weight:400;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);white-space:nowrap}
.dp-related__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}
.dp-related-card{text-decoration:none;color:var(--text);background:var(--card-bg);border-radius:18px;overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--border);transition:transform .3s}
.dp-related-card:hover{transform:translateY(-5px)}
.dp-related-card__img-wrap{position:relative;aspect-ratio:1;overflow:hidden;background:var(--cream2)}
.dp-related-card__img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.dp-related-card:hover .dp-related-card__img{transform:scale(1.06)}
.dp-related-card__overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(26,18,8,.35) 0%,transparent 50%);pointer-events:none}
.dp-related-card__body{padding:12px 14px 14px}
.dp-related-card__name{font-family:var(--font-display);font-size:14px;font-weight:700;margin-bottom:5px}
.dp-related-card__rating{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--muted);margin-bottom:4px}
.dp-related-card__price{font-size:16px;font-weight:700;color:var(--gold);font-family:var(--font-display)}

/* CART DRAWER */
.dp-cart-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:90;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(4px)}
.dp-cart-backdrop.open{opacity:1;pointer-events:all}
.dp-cart-drawer{position:fixed;top:0;right:0;width:min(400px,100vw);height:100vh;background:var(--card-bg);z-index:100;transform:translateX(100%);transition:transform .4s cubic-bezier(.22,.61,.36,1);display:flex;flex-direction:column;box-shadow:-10px 0 60px rgba(0,0,0,.2)}
.dp-cart-drawer.open{transform:translateX(0)}
.dp-cart-drawer__head{display:flex;justify-content:space-between;align-items:center;padding:24px;border-bottom:1px solid var(--border)}
.dp-cart-drawer__head h3{font-family:var(--font-display);font-size:22px;color:var(--text)}
.dp-cart-close{background:none;border:none;font-size:20px;cursor:pointer;color:var(--muted);width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
.dp-cart-close:hover{background:var(--cream2)}
.dp-cart-drawer__items{flex:1;overflow-y:auto;padding:16px 24px}
.dp-cart-empty{text-align:center;color:var(--muted);padding:60px 0;font-size:15px}
.dp-cart-item{padding:14px 0;border-bottom:1px solid rgba(201,147,58,.08)}
.dp-cart-item__name{font-weight:600;font-size:14px;color:var(--text);margin-bottom:4px}
.dp-cart-item__meta{font-size:12px;color:var(--muted)}
.dp-cart-item__price-row{display:flex;align-items:center;gap:8px;margin-top:4px}
.dp-cart-item__original{font-size:12px;color:var(--muted);text-decoration:line-through}
.dp-cart-item__final{font-family:var(--font-display);font-weight:700;color:var(--gold);font-size:16px}
.dp-cart-item__disc{font-size:11px;background:rgba(37,160,102,.15);color:#1e6b4a;padding:2px 8px;border-radius:50px;font-weight:600}
.dp-cart-item__footer { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 12px; }
.dp-cart-qty { display: flex; align-items: center; gap: 6px; background: var(--cream2); border: 1px solid var(--border); border-radius: 50px; padding: 2px; }
.dp-cart-qty button { width: 26px; height: 26px; border-radius: 50%; border: none; background: var(--card-bg); color: var(--text); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.1); font-size: 15px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.dp-cart-qty button:hover { background: var(--gold); color: #fff; }
.dp-cart-qty span { font-size: 14px; font-weight: 600; min-width: 24px; text-align: center; color: var(--text); }
.dp-cart-item__remove { background: none; border: none; color: var(--muted); font-size: 15px; cursor: pointer; padding: 0 4px; transition: color .2s; line-height: 1; }
.dp-cart-item__remove:hover { color: var(--danger); }
.dp-cart-drawer__foot{padding:20px 24px;border-top:1px solid var(--border)}
.dp-cart-total__row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:4px}
.dp-cart-total__savings{font-size:12px;color:#1e6b4a;font-weight:600;background:rgba(37,160,102,.1);padding:6px 12px;border-radius:8px;margin-bottom:8px;text-align:center}
.dp-cart-total__final{display:flex;justify-content:space-between;font-size:16px;font-weight:700;color:var(--text);margin-bottom:16px}
.dp-cart-total__final span:last-child{font-family:var(--font-display);font-size:22px;color:var(--gold)}
.dp-cart-clear{width:100%;background:none;border:1px solid var(--border);border-radius:10px;padding:8px;font-size:13px;color:var(--muted);cursor:pointer;transition:all .2s}
.dp-cart-clear:hover{border-color:#e63946;color:#e63946}
.dp-float-cart{position:fixed;bottom:28px;right:28px;z-index:80;width:58px;height:58px;background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;border:none;cursor:pointer;box-shadow:0 6px 30px rgba(201,147,58,.45);transition:transform .25s,box-shadow .25s}
.dp-float-cart:hover{transform:scale(1.1) translateY(-2px);box-shadow:0 12px 40px rgba(201,147,58,.6)}
.dp-float-cart__count{position:absolute;top:-4px;right:-4px;background:#e63946;color:#fff;font-size:11px;font-weight:700;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--cream)}

.dp-footer{background:var(--ink);color:rgba(255,255,255,.4);text-align:center;padding:36px 20px}
.dp-footer__brand{font-family:var(--font-display);font-size:18px;color:var(--gold-light);margin-bottom:6px}
.dp-footer__copy{font-size:12px;letter-spacing:.05em}

@@media(max-width:900px){
    .dp-main{grid-template-columns:1fr;padding:24px 20px;gap:28px}
    .dp-gallery{position:static}
    .dp-nav{padding:12px 16px}
    .dp-nav__wa span{display:none}
    .dp-nav__wa{padding:9px 12px;gap:0}
    .dp-nav__logo{display:none}
    .dp-back span{display:none}
    .dp-back{gap:0}
    .dp-price__value{font-size:38px}
    .dp-reviews,.dp-related{padding:0 20px 40px}
    .dp-reviews__summary{flex-wrap:wrap}
    .dp-reviews__write-btn{margin-left:0;margin-top:8px}
    .dp-float-cart{bottom:20px;right:20px;width:52px;height:52px}
}
@@media(max-width:480px){
    .dp-features{gap:8px}.dp-feature{font-size:11px;padding:6px 12px}
    .dp-name{font-size:28px}
    .dp-thumbs{gap:8px}.dp-thumb{width:64px;height:64px;border-radius:10px}
    .dp-reviews__list{grid-template-columns:1fr}
}
@@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
</style>

<script>
const basePrice = @Model.Modak.Price;
const productName = "@Model.Modak.Name";
const productId = @Model.Modak.Id;
const productUnit = "@Model.Modak.Unit";
let currentIndex = 0;
const images = [@Html.Raw(string.Join(",", Model.Modak.Images.Select(i => $"\"{i}\"")))];

function setMain(src, thumbEl, index){
    document.getElementById('mainImg').src=src;
    currentIndex=index;
    document.querySelectorAll('.dp-thumb').forEach(t=>t.classList.remove('active'));
    if(thumbEl)thumbEl.classList.add('active');
}
function changeMain(dir){
    if(!images.length)return;
    currentIndex=(currentIndex+dir+images.length)%images.length;
    document.getElementById('mainImg').src=images[currentIndex];
    document.querySelectorAll('.dp-thumb').forEach((t,i)=>t.classList.toggle('active',i===currentIndex));
}

function toggleAccordion(id){
    const body=document.getElementById(id);
    const icon=document.getElementById('icon-'+id);
    const isOpen=body.classList.contains('open');
    document.querySelectorAll('.dp-accordion__body').forEach(b=>b.classList.remove('open'));
    document.querySelectorAll('.dp-accordion__icon').forEach(i=>i.classList.remove('open'));
    if(!isOpen){body.classList.add('open');icon.classList.add('open');}
}

function getDiscount(qty){
    if(qty>=20)return 20;
    if(qty>=15)return 15;
    if(qty>=10)return 10;
    if(qty>=5) return 5;
    return 0;
}
function setPieces(n, btn){
    document.getElementById('qty').value=n;
    document.querySelectorAll('.dp-pill').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    syncPrice();
}
function changeQty(delta){
    const i=document.getElementById('qty');
    i.value=Math.max(1,parseInt(i.value)+delta);
    document.querySelectorAll('.dp-pill').forEach(p=>p.classList.remove('active'));
    syncPrice();
}
function getGiftCost(){return document.getElementById('giftWrap').checked?50:0}

function syncPrice(){
    const qty=Math.max(1,parseInt(document.getElementById('qty').value)||1);
    document.getElementById('qty').value=qty;
    const disc=getDiscount(qty);
    const subtotal=basePrice*qty;
    const discounted=Math.round(subtotal*(1-disc/100));
    const total=discounted+getGiftCost();

    document.getElementById('detailPrice').textContent=discounted;
    document.getElementById('qtyTotal').textContent='\u20B9'+total;

    const banner=document.getElementById('discBanner');
    if(disc>0){
        banner.style.display='block';
        banner.textContent=`\uD83C\uDF89 ${disc}% bulk discount applied on ${qty} items! You save \u20B9${subtotal-discounted}`;
    } else {
        banner.style.display='none';
    }
}

/* ── CART LOGIC ───────────────────────── */
function loadCart(){return JSON.parse(localStorage.getItem('msCart')||'[]')}
function saveCart(c){localStorage.setItem('msCart',JSON.stringify(c))}

function addToCart(){
    const qty=parseInt(document.getElementById('qty').value);
    const gift=document.getElementById('giftWrap').checked;
    const giftCost=gift?50:0;
    const disc=getDiscount(qty);
    const originalTotal=basePrice*qty;
    const discountedSubtotal=Math.round(originalTotal*(1-disc/100));
    const finalTotal=discountedSubtotal+giftCost;
    const label=gift?productName+' \uD83C\uDF81':productName;
    const key='item_'+productId+(gift?'_gift':'');

    let cart=loadCart();
    const ex=cart.find(i=>i.key===key);
    if(ex){
        ex.qty+=qty;
        const newOrig=basePrice*ex.qty;
        const newDisc=getDiscount(ex.qty);
        ex.discPct=newDisc;
        ex.originalTotal=newOrig;
        ex.total=Math.round(newOrig*(1-newDisc/100))+ex.giftCost;
    } else {
        cart.push({key,id:productId,name:label,price:basePrice,giftCost,qty,unit:productUnit,discPct:disc,originalTotal,total:finalTotal});
    }
    saveCart(cart);
    renderCart();
    showToast('\u2713 Added to cart');
    toggleCart(true);
}

function updateCartItemQty(key, delta){
    let cart=loadCart();
    const idx=cart.findIndex(i=>i.key===key);
    if(idx>-1){
        cart[idx].qty += delta;
        if(cart[idx].qty <= 0){
            cart.splice(idx, 1);
        } else {
            const it = cart[idx];
            const newOrig = it.price * it.qty;
            const newDisc = getDiscount(it.qty);
            it.discPct = newDisc;
            it.originalTotal = newOrig;
            it.total = Math.round(newOrig * (1 - newDisc/100)) + (it.giftCost || 0);
        }
        saveCart(cart);
        renderCart();
    }
}

function clearCart(){saveCart([]);renderCart()}
function toggleCart(forceOpen){
    const d=document.getElementById('cartDrawer'),b=document.getElementById('cartBackdrop');
    const open=d.classList.contains('open');
    if(forceOpen===true||!open){d.classList.add('open');b.classList.add('open')}
    else{d.classList.remove('open');b.classList.remove('open')}
}

function renderCart(){
    const cart=loadCart();
    const container=document.getElementById('cartItems'),foot=document.getElementById('cartFoot');
    const count=document.getElementById('cartCount'),totalWrap=document.getElementById('cartTotalWrap');
    const totalQty=cart.reduce((s,i)=>s+i.qty,0);
    const grossTotal=cart.reduce((s,i)=>s+i.originalTotal+(i.giftCost||0),0);
    const discountedTotal=cart.reduce((s,i)=>s+i.total,0);
    const savings=grossTotal-discountedTotal;

    count.style.display=totalQty>0?'flex':'none'; count.textContent=totalQty;
    const floatCount=document.getElementById('floatCartCount');
    if(floatCount){floatCount.style.display=totalQty>0?'flex':'none';floatCount.textContent=totalQty;}
    foot.style.display=cart.length?'block':'none';

    if(!cart.length){
        container.innerHTML='<div class="dp-cart-empty">Your cart is empty \uD83D\uDED2</div>';
        totalWrap.innerHTML='';
        return;
    }

    container.innerHTML=cart.map(i=>{
        const giftLine=i.giftCost?`<span style="color:var(--gold);font-size:11px;display:block;margin-top:2px;"> + \u20B950 gift wrap</span>`:'';
        const meta=i.unit?`Unit: ${i.unit}`:'';
        const priceBlock=i.discPct
            ? `<div style="text-align:right">
                 <div class="dp-cart-item__original">\u20B9${i.originalTotal+(i.giftCost||0)}</div>
                 <div class="dp-cart-item__final">\u20B9${i.total}</div>
                 <div class="dp-cart-item__disc" style="margin-top:2px">${i.discPct}% off</div>
               </div>`
            : `<div style="text-align:right"><div class="dp-cart-item__final">\u20B9${i.total}</div></div>`;
            
        return `<div class="dp-cart-item">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div class="dp-cart-item__name">${i.name}</div>
                    <div class="dp-cart-item__meta">${meta} ${giftLine}</div>
                </div>
                <button class="dp-cart-item__remove" onclick="updateCartItemQty('${i.key}', -9999)" title="Remove item">&#10005;</button>
            </div>
            <div class="dp-cart-item__footer">
                <div class="dp-cart-qty">
                    <button onclick="updateCartItemQty('${i.key}', -1)">&#8722;</button>
                    <span>${i.qty}</span>
                    <button onclick="updateCartItemQty('${i.key}', 1)">+</button>
                </div>
                ${priceBlock}
            </div>
        </div>`;
    }).join('');

    let totalHtml=`<div class="dp-cart-total__row"><span>Items subtotal</span><span>\u20B9${grossTotal}</span></div>`;
    if(savings>0) totalHtml+=`<div class="dp-cart-total__savings">\uD83C\uDF89 You save \u20B9${savings} on this order!</div>`;
    
    if(activeDelivery){
        let dLabel = activeDelivery.free ? `<span style="color:#1e6b4a;font-weight:700">FREE \u2705</span>` : `\u20B9${activeDelivery.charge}`;
        let actualCharge = activeDelivery.charge;
        
        if (activeDelivery.charge === 'Custom') {
            dLabel = `<span style="color:var(--gold-dim);font-weight:600">To be confirmed</span>`;
            actualCharge = 0;
        } else if(activeDelivery.zone === 'Zone A' && discountedTotal >= 500) {
            dLabel = `<span style="color:#1e6b4a;font-weight:700">FREE \u2705</span>`;
            actualCharge = 0;
        }
        
        totalHtml+=`<div class="dp-cart-total__row"><span>Delivery (${activeDelivery.area})</span><span>${dLabel}</span></div>`;
        if(actualCharge > 0 && activeDelivery.zone === 'Zone A' && activeDelivery.charge !== 'Custom')
            totalHtml+=`<div style="font-size:11px;color:var(--muted);margin-bottom:4px">Add \u20B9${500-discountedTotal} more for FREE delivery \uD83D\uDE9A</div>`;
            
        let grandTotalLabel = activeDelivery.charge === 'Custom' ? `\u20B9${discountedTotal} <span style="font-size:14px;color:var(--muted)">+ Del</span>` : `\u20B9${discountedTotal + actualCharge}`;    
        totalHtml+=`<div class="dp-cart-total__final"><span>Grand Total</span><span>${grandTotalLabel}</span></div>`;
    } else {
        totalHtml+=`<div class="dp-cart-total__row" style="font-style:italic"><span>Delivery</span><span style="color:var(--muted)">Calculated at checkout</span></div>`;
        totalHtml+=`<div class="dp-cart-total__final"><span>Items Total</span><span>\u20B9${discountedTotal}</span></div>`;
    }
    
    totalWrap.innerHTML=totalHtml;
}

/* ── SMART WHATSAPP POPUP & LOGIC ──────────────── */
const SHOP = {lat:19.021055, lng:72.835238};
let activeDelivery = null;

function deg2rad(d){return d*(Math.PI/180)}
function getDistance(lat1,lng1,lat2,lng2){
    const R=6371;
    const dLat=deg2rad(lat2-lat1),dLng=deg2rad(lng2-lng1);
    const a=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(deg2rad(lat1))*Math.cos(deg2rad(lat2))*Math.sin(dLng/2)*Math.sin(dLng/2);
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
function calcDeliveryCharge(distKm){
    if(distKm<=5)return{charge:30,time:'30–40 mins',zone:'Zone A',free:false};
    if(distKm<=8)return{charge:50,time:'45–60 mins',zone:'Zone B',free:false};
    return null;
}

let pendingOrderData = null;
let pendingIsCart = false;

function openWaModal(orderData, isCart) {
    if (activeDelivery) {
        executeWhatsAppRedirect(orderData, isCart, activeDelivery);
        return;
    }
    pendingOrderData = orderData;
    pendingIsCart = isCart;
    document.getElementById('waModalOverlay').classList.add('show');
    document.getElementById('waModal').classList.add('show');
    setTimeout(() => document.getElementById('waModalInput').focus(), 100);
}

function closeWaModal() {
    document.getElementById('waModalOverlay').classList.remove('show');
    document.getElementById('waModal').classList.remove('show');
}

async function submitWaModal() {
    const loc = document.getElementById('waModalInput').value.trim();
    if(!loc) { alert("Please enter a location."); return; }
    
    const btn = document.getElementById('waModalSubmitBtn');
    btn.innerHTML = 'Checking...'; btn.disabled = true;

    try {
        const res = await fetch(`/api/delivery-check?q=${encodeURIComponent(loc)}`);
        const data = await res.json();
        
        if(data.error) { alert(data.error); btn.innerHTML = 'Order'; btn.disabled = false; return; }
        
        if(!data.deliverable) { 
            activeDelivery = { charge: 'Custom', time: 'To be confirmed', zone: 'Out of Range', free: false, area: data.area, dist: data.dist };
        } else {
            activeDelivery = { charge: data.charge, time: data.time, zone: data.zone, free: data.charge === 0, area: data.area, dist: data.dist };
        }
        
        closeWaModal();
        btn.innerHTML = 'Order'; btn.disabled = false;
        renderCart(); 
        executeWhatsAppRedirect(pendingOrderData, pendingIsCart, activeDelivery);
    } catch(e) {
        activeDelivery = { charge: 'Custom', time: 'To be confirmed', zone: 'Unknown', free: false, area: loc, dist: '?' };
        closeWaModal();
        btn.innerHTML = 'Order'; btn.disabled = false;
        executeWhatsAppRedirect(pendingOrderData, pendingIsCart, activeDelivery);
    }
}

function useMyLocationModal() {
    if (!navigator.geolocation) { alert("Geolocation not supported."); return; }
    
    const btn = document.getElementById('waModalLocBtn');
    btn.innerHTML = '⏳'; btn.disabled = true;
    
    navigator.geolocation.getCurrentPosition(
        pos => {
            const dist = getDistance(SHOP.lat, SHOP.lng, pos.coords.latitude, pos.coords.longitude);
            const info = calcDeliveryCharge(dist);
            
            // FIX: Don't block! If info is null, set to Custom instead of alerting
            if (!info) {
                activeDelivery = { 
                    charge: 'Custom', 
                    time: 'To be confirmed', 
                    zone: 'Out of Range', 
                    free: false, 
                    area: 'Your Location', 
                    dist: dist.toFixed(1) 
                };
            } else {
                activeDelivery = { ...info, area: "Your Location", dist: dist.toFixed(1) };
            }
            
            closeWaModal();
            btn.innerHTML = '📍'; btn.disabled = false;
            renderCart(); // Sync visual cart
            
            // Redirect to WhatsApp immediately
            executeWhatsAppRedirect(pendingOrderData, pendingIsCart, activeDelivery);
        },
        err => { 
            alert("Could not get location. Please type your pincode manually."); 
            btn.innerHTML = '📍'; btn.disabled = false; 
        },
        {timeout: 8000}
    );
}

function executeWhatsAppRedirect(data, isCart, delivery) {
    let msg = 'Hello Modak Samrat! 🙏%0A%0A';
    let itemsTotal = 0;
    
    if (isCart) {
        msg += '*Order Summary:*%0A';
        const cart = data;
        const gross = cart.reduce((s,i) => s + i.originalTotal + (i.giftCost||0), 0);
        itemsTotal = cart.reduce((s,i) => s + i.total, 0);
        const savings = gross - itemsTotal;
        
        cart.forEach(i => {
            const discLine = i.discPct ? ` _(${i.discPct}% bulk discount)_` : '';
            const giftLine = i.giftCost ? ' + ₹50 gift wrap' : '';
            const orig = i.originalTotal + (i.giftCost||0);
            if(i.discPct) {
                msg += `• ${encodeURIComponent(i.name)} (${i.qty} ${encodeURIComponent(i.unit || '')}) = ~₹${orig}~ *₹${i.total}*${encodeURIComponent(discLine)}%0A`;
            } else {
                msg += `• ${encodeURIComponent(i.name)} (${i.qty} ${encodeURIComponent(i.unit || '')}) = *₹${i.total}*${encodeURIComponent(giftLine)}%0A`;
            }
        });
        if(savings > 0) msg += `%0A🎉 *Bulk Discount Savings: ₹${savings}*%0A`;
    } else {
        msg += '*New Order:*%0A';
        itemsTotal = data.total;
        msg += `• ${encodeURIComponent(data.name)} (${data.qty} ${encodeURIComponent(data.unit)})`;
        if (data.disc > 0) msg += ` _(${data.disc}% bulk discount)_`;
        if (data.gift) msg += ` + Gift Wrap 🎁`;
        msg += ` = *₹${data.total}*%0A`;
    }
    
    let actualCharge = delivery.charge;
    let isFree = delivery.free;
    let dText = '';
    let grandTotalText = '';

    if (actualCharge === 'Custom') {
        dText = 'To be confirmed on chat';
        grandTotalText = `₹${itemsTotal} + Delivery`;
    } else {
        if(delivery.zone === 'Zone A' && itemsTotal >= 500) { actualCharge = 0; isFree = true; }
        const grandTotal = itemsTotal + actualCharge;
        dText = isFree ? 'FREE ✅' : `₹${actualCharge}`;
        grandTotalText = `₹${grandTotal}`;
    }
    
    msg += `%0A🚚 *Delivery Details:*%0A• Location: ${encodeURIComponent(delivery.area)} (${delivery.dist}km)%0A• Charge: ${encodeURIComponent(dText)}%0A• Est. Time: ${encodeURIComponent(delivery.time)}%0A`;
    msg += `%0A⭐ *Grand Total: ${encodeURIComponent(grandTotalText)}*`;
    msg += `%0A%0APlease confirm availability. Thank you! 🙏`;
    
    window.location.href = 'https://wa.me/917021923652?text=' + msg;
}

function checkoutWhatsApp(){
    const cart=loadCart();if(!cart.length)return;
    openWaModal(cart, true);
}

function orderWhatsApp() {
    const qty = document.getElementById('qty').value;
    const gift = document.getElementById('giftWrap').checked;
    const disc = getDiscount(parseInt(qty));
    const orig = basePrice * parseInt(qty);
    const discounted = Math.round(orig * (1 - disc / 100));
    const total = discounted + (gift ? 50 : 0);
    const data = { name: productName, unit: productUnit, qty, base: basePrice, gift, disc, orig, discounted, total };
    openWaModal(data, false);
}

/* ── TOAST ────────────────────────────── */
function showToast(msg){
    const t=document.getElementById('toast');
    t.textContent=msg;
    t.style.visibility='visible';
    t.classList.add('show');
    setTimeout(()=>{
        t.classList.remove('show');
        setTimeout(()=>{t.style.visibility='hidden';},400);
    },2800);
}

renderCart();

document.querySelectorAll('.dp-info > *').forEach((el,i)=>{
    el.style.animation=`fadeUp 0.5s ease ${i*0.06}s both`;
});
</script>