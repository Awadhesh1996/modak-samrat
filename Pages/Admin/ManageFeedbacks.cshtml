@page
@model ManageFeedbacksModel

@{
    ViewData["Title"] = "Manage Feedbacks – Modak Samrat Admin";
}

<div class="am-root">

    <aside class="am-sidebar">
        <div class="am-sidebar__brand">
            <div class="am-sidebar__logo">MS</div>
            <div>
                <div class="am-sidebar__name">Modak Samrat</div>
                <div class="am-sidebar__role">Admin Panel</div>
            </div>
        </div>
        <nav class="am-sidebar__nav">
            <a href="/Admin/Dashboard" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <a href="/Admin/AddModak" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Add Modak
            </a>
            <a href="/Admin/ManageSettings" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
                Settings
            </a>
            <a href="/Admin/ManageFeedbacks" class="am-nav-item active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Feedbacks
            </a>
            <a href="/" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                View Store
            </a>
            <form method="post" asp-page-handler="Logout" class="am-nav-item am-nav-item--danger" style="margin-top:auto; background:none; border:none; padding:0;">
                <button type="submit" style="background:none; border:none; color:inherit; font:inherit; display:flex; align-items:center; gap:12px; width:100%; cursor:pointer; padding:12px 14px; border-radius:12px; transition:all 0.2s;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Logout
                </button>
            </form>
        </nav>
    </aside>

    <main class="am-main">

        <div class="am-topbar">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <button class="am-mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open Menu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <div>
                    <h1 class="am-topbar__title">Customer Feedbacks</h1>
                    <p class="am-topbar__sub">@Model.Feedbacks.Count review@(Model.Feedbacks.Count != 1 ? "s" : "") · Average rating: ⭐ @Model.AverageRating.ToString("F1")</p>
                </div>
            </div>
        </div>

        <div class="am-stats-row">
            <div class="am-stat">
                <div class="am-stat__val">@Model.Feedbacks.Count</div>
                <div class="am-stat__label">Total Reviews</div>
            </div>
            <div class="am-stat">
                <div class="am-stat__val">@Model.AverageRating.ToString("F1")★</div>
                <div class="am-stat__label">Average Rating</div>
            </div>
            <div class="am-stat">
                <div class="am-stat__val">@Model.Feedbacks.Count(f => f.Rating >= 4)</div>
                <div class="am-stat__label">Happy Customers (4★+)</div>
            </div>
            <div class="am-stat">
                <div class="am-stat__val">@Model.Feedbacks.Count(f => f.WouldRecommend)</div>
                <div class="am-stat__label">Would Recommend</div>
            </div>
        </div>

        @if (!Model.Feedbacks.Any())
        {
            <div class="am-empty">
                <div class="am-empty__icon">💬</div>
                <p>No feedbacks yet. They'll appear here once customers submit reviews.</p>
            </div>
        }
        else
        {
            <div class="am-feedback-grid">
                @foreach (var fb in Model.Feedbacks)
                {
                    <div class="am-fb-card">
                        <div class="am-fb-card__head">
                            <div class="am-fb-card__avatar">@fb.Name[0].ToString().ToUpper()</div>
                            <div class="am-fb-card__meta">
                                <div class="am-fb-card__name">@fb.Name
                                    @if (fb.WouldRecommend)
                                    {
                                        <span class="am-fb-card__rec">👍 Recommends</span>
                                    }
                                </div>
                                <div class="am-fb-card__info">
                                    @if (!string.IsNullOrEmpty(fb.Phone)) { <span>📱 @fb.Phone</span> }
                                    @if (!string.IsNullOrEmpty(fb.ModakName)) { <span>🍡 @fb.ModakName</span> }
                                    @if (!string.IsNullOrEmpty(fb.Occasion)) { <span>🎉 @fb.Occasion</span> }
                                </div>
                            </div>
                            <div class="am-fb-card__stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24"
                                         fill="@(s <= fb.Rating ? "#c9933a" : "none")"
                                         stroke="#c9933a" stroke-width="2">
                                        <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                                    </svg>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(fb.Tags))
                        {
                            <div class="am-fb-card__tags">
                                @foreach (var tag in fb.Tags.Split(','))
                                {
                                    <span class="am-fb-card__tag">@tag.Trim()</span>
                                }
                            </div>
                        }
                        <p class="am-fb-card__msg">"@fb.Message"</p>
                        <div class="am-fb-card__foot">
                            <span class="am-fb-card__date">@fb.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                            <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this review?')">
                                <input type="hidden" name="id" value="@fb.Id">
                                <button type="submit" class="am-fb-card__del">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

<style>
:root{--gold:#c9933a;--gold-light:#e8b96a;--gold-dim:#7a5520;--ink:#1a1208;--bg:#f8f4ef;--card:#ffffff;--text:#2d1f0e;--muted:#8b7355;--border:rgba(201,147,58,.18);--danger:#e63946;--font-display:'Playfair Display',Georgia,serif;--font-body:'DM Sans',sans-serif;--shadow:0 4px 24px rgba(0,0,0,.08)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);font-family:var(--font-body);color:var(--text);min-height:100vh}
.am-root{display:flex;min-height:100vh}

.am-sidebar{width:240px;background:var(--ink);display:flex;flex-direction:column;padding:28px 0;flex-shrink:0;position:sticky;top:0;height:100vh}
.am-sidebar__brand{display:flex;align-items:center;gap:12px;padding:0 24px 32px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:16px}
.am-sidebar__logo{width:40px;height:40px;background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:16px;font-weight:700;color:#fff;flex-shrink:0}
.am-sidebar__name{font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--gold-light);line-height:1.2}
.am-sidebar__role{font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.am-sidebar__nav{display:flex;flex-direction:column;gap:4px;padding:0 12px; height:100%;}
.am-nav-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.55);font-size:14px;font-weight:500;transition:all .2s}
.am-nav-item:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9)}
.am-nav-item.active{background:linear-gradient(135deg,rgba(201,147,58,.2),rgba(201,147,58,.1));color:var(--gold-light);border:1px solid rgba(201,147,58,.2)}
.am-nav-item--danger{color:rgba(230,57,70,.6);}
.am-nav-item--danger:hover button {color:var(--danger);}
.am-nav-item--danger:hover {background:rgba(230,57,70,.1);}

.am-main{flex:1;padding:40px 48px;overflow-y:auto}
.am-topbar{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px}
.am-topbar__title{font-family:var(--font-display);font-size:28px;font-weight:900;color:var(--text);margin-bottom:4px}
.am-topbar__sub{font-size:14px;color:var(--muted)}

.am-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px}
.am-stat{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;text-align:center;box-shadow:var(--shadow)}
.am-stat__val{font-family:var(--font-display);font-size:28px;font-weight:900;color:var(--gold);margin-bottom:4px}
.am-stat__label{font-size:12px;color:var(--muted)}

.am-empty{text-align:center;padding:80px 20px;color:var(--muted)}
.am-empty__icon{font-size:48px;display:block;margin-bottom:16px}

.am-feedback-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px}
.am-fb-card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:22px;box-shadow:var(--shadow)}
.am-fb-card__head{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}
.am-fb-card__avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--gold-dim),var(--gold));color:#fff;font-family:var(--font-display);font-size:18px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.am-fb-card__meta{flex:1}
.am-fb-card__name{font-size:14px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:8px;margin-bottom:4px}
.am-fb-card__rec{font-size:11px;background:rgba(37,160,102,.1);color:#1e6b4a;padding:2px 8px;border-radius:50px;font-weight:600}
.am-fb-card__info{display:flex;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--muted)}
.am-fb-card__stars{display:flex;gap:2px;flex-shrink:0}
.am-fb-card__tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.am-fb-card__tag{font-size:10px;padding:3px 10px;background:var(--bg);border:1px solid var(--border);border-radius:50px;color:var(--muted)}
.am-fb-card__msg{font-size:13px;color:var(--muted);line-height:1.7;font-style:italic;margin-bottom:14px}
.am-fb-card__foot{display:flex;justify-content:space-between;align-items:center}
.am-fb-card__date{font-size:11px;color:var(--muted)}
.am-fb-card__del{background:none;border:1px solid rgba(230,57,70,.3);color:var(--danger);font-size:12px;padding:4px 12px;border-radius:8px;cursor:pointer;font-family:var(--font-body);transition:all .2s}
.am-fb-card__del:hover{background:var(--danger);color:#fff}

.am-mobile-menu-btn { display: none; background: none; border: none; color: var(--text); cursor: pointer; padding: 4px; margin-top: 4px; }
.am-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 40; backdrop-filter: blur(2px); }

@@media(max-width:1100px){.am-stats-row{grid-template-columns:repeat(2,1fr)}}
@@media(max-width:900px){
    .am-mobile-menu-btn { display: block; }
    .am-main { padding: 24px 20px; }
    .am-sidebar { position: fixed; left: -260px; top: 0; bottom: 0; z-index: 50; transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 4px 0 24px rgba(0,0,0,0.2); }
    .am-sidebar.is-open { left: 0; }
    .am-sidebar-overlay.is-active { display: block; }
}
</style>

<script>
// Mobile Sidebar Logic
document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.querySelector('.am-sidebar');
    
    if (menuBtn && sidebar) {
        const overlay = document.createElement('div');
        overlay.className = 'am-sidebar-overlay';
        document.body.appendChild(overlay);

        menuBtn.addEventListener('click', () => {
            sidebar.classList.add('is-open');
            overlay.classList.add('is-active');
            document.body.style.overflow = 'hidden'; 
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('is-open');
            overlay.classList.remove('is-active');
            document.body.style.overflow = '';
        });
    }
});
</script>