@page
@model ManageSettingsModel

@{
    ViewData["Title"] = "Manage Settings – Modak Samrat Admin";
}

<div class="am-root">

    <aside class="am-sidebar">
        <div class="am-sidebar__brand">
            <div class="am-sidebar__logo">MS</div>
            <div>
                <div class="am-sidebar__name">Modak Samrat</div>
                <div class="am-sidebar__role">Admin Panel</div>
            </div>
        </div>
        <nav class="am-sidebar__nav">
            <a href="/Admin/Dashboard" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <a href="/Admin/AddModak" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Add Modak
            </a>
            <a href="/Admin/ManageSettings" class="am-nav-item active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
                Settings
            </a>
            <a href="/Admin/ManageFeedbacks" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Feedbacks
            </a>
            <a href="/" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                View Store
            </a>
            <form method="post" asp-page-handler="Logout" class="am-nav-item am-nav-item--danger" style="margin-top:auto; background:none; border:none; padding:0;">
                <button type="submit" style="background:none; border:none; color:inherit; font:inherit; display:flex; align-items:center; gap:12px; width:100%; cursor:pointer; padding:12px 14px; border-radius:12px; transition:all 0.2s;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Logout
                </button>
            </form>
        </nav>
    </aside>

    <main class="am-main">

        <div class="am-topbar">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <button class="am-mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open Menu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <div>
                    <h1 class="am-topbar__title">Store Settings</h1>
                    <p class="am-topbar__sub">Manage festive events, trust badges and more</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="am-alert @(Model.IsError ? "am-alert--error" : "am-alert--success")">
                @Model.Message
            </div>
        }

        <div class="am-settings-grid">

            <div class="am-card">
                <div class="am-card__head">
                    <div class="am-card__head-icon">🎉</div>
                    <div>
                        <h2 class="am-card__title">Festive Event &amp; Countdown</h2>
                        <p class="am-card__sub">Control the countdown banner shown on the store</p>
                    </div>
                    <div class="am-toggle-wrap">
                        <span class="am-toggle-label">@(Model.FestiveEvent.IsActive ? "Live" : "Hidden")</span>
                        <form method="post" asp-page-handler="ToggleFestive" style="display:inline">
                            <button type="submit" class="am-toggle @(Model.FestiveEvent.IsActive ? "am-toggle--on" : "")">
                                <span class="am-toggle__knob"></span>
                            </button>
                        </form>
                    </div>
                </div>

                <form method="post" enctype="multipart/form-data" asp-page-handler="SaveFestive" class="am-form">
                    <div class="am-form__row">
                        <div class="am-field">
                            <label class="am-label">Event Title</label>
                            <input type="text" name="Title" class="am-input" value="@Model.FestiveEvent.Title" required>
                        </div>
                        <div class="am-field">
                            <label class="am-label">Event Date &amp; Time</label>
                            <input type="datetime-local" name="EventDate" class="am-input"
                                   value="@Model.FestiveEvent.EventDate.ToString("yyyy-MM-ddTHH:mm")" required>
                        </div>
                    </div>
                    <div class="am-field">
                        <label class="am-label">Description</label>
                        <textarea name="Description" class="am-textarea" rows="2">@Model.FestiveEvent.Description</textarea>
                    </div>
                    <div class="am-field">
                        <label class="am-label">Festive Image</label>
                        @if (!string.IsNullOrEmpty(Model.FestiveEvent.ImagePath))
                        {
                            <div class="am-current-img">
                                <img src="@Model.FestiveEvent.ImagePath" alt="Current festive image">
                                <span>Current image</span>
                            </div>
                        }
                        <div class="am-dropzone am-dropzone--small" onclick="document.getElementById('festiveImg').click()">
                            <input type="file" id="festiveImg" name="FestiveImage" accept="image/*" style="display:none" onchange="previewFestive(this)">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17,8 12,3 7,8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            <span id="festivePrevText">Click to upload new image (optional)</span>
                        </div>
                        <img id="festivePrev" src="" alt="" style="display:none;width:80px;height:80px;object-fit:cover;border-radius:10px;margin-top:8px;border:2px solid var(--border)">
                    </div>
                    <div class="am-form__footer" style="border:none;padding:0">
                        <button type="submit" class="am-btn am-btn--primary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/></svg>
                            Save Event
                        </button>
                    </div>
                </form>
            </div>

            <div class="am-card">
                <div class="am-card__head">
                    <div class="am-card__head-icon">🏅</div>
                    <div>
                        <h2 class="am-card__title">Trust Badges</h2>
                        <p class="am-card__sub">Edit the badges shown in the dark strip below the header</p>
                    </div>
                </div>

                <form method="post" asp-page-handler="SaveBadges" class="am-form">
                    @for (int i = 0; i < Model.TrustBadges.Count; i++)
                    {
                        <div class="am-badge-row">
                            <input type="hidden" name="Badges[@i].Id" value="@Model.TrustBadges[i].Id">
                            <div class="am-field am-field--icon">
                                <label class="am-label">Icon</label>
                                <input type="text" name="Badges[@i].Icon" class="am-input am-input--emoji"
                                       value="@Model.TrustBadges[i].Icon" maxlength="4">
                            </div>
                            <div class="am-field" style="flex:1">
                                <label class="am-label">Badge Text</label>
                                <input type="text" name="Badges[@i].Title" class="am-input"
                                       value="@Model.TrustBadges[i].Title" required>
                            </div>
                        </div>
                    }
                    <div class="am-form__footer" style="border:none;padding-top:8px">
                        <button type="submit" class="am-btn am-btn--primary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v14a2 2 0 01-2 2z"/><polyline points="17,21 17,13 7,13 7,21"/></svg>
                            Save Badges
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </main>
</div>

<style>
:root{--gold:#c9933a;--gold-light:#e8b96a;--gold-dim:#7a5520;--ink:#1a1208;--bg:#f8f4ef;--card:#ffffff;--text:#2d1f0e;--muted:#8b7355;--border:rgba(201,147,58,.18);--danger:#e63946;--success:#25a066;--font-display:'Playfair Display',Georgia,serif;--font-body:'DM Sans',sans-serif;--shadow:0 4px 24px rgba(0,0,0,.08);--radius:16px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);font-family:var(--font-body);color:var(--text);min-height:100vh}
.am-root{display:flex;min-height:100vh}

.am-sidebar{width:240px;background:var(--ink);display:flex;flex-direction:column;padding:28px 0;flex-shrink:0;position:sticky;top:0;height:100vh}
.am-sidebar__brand{display:flex;align-items:center;gap:12px;padding:0 24px 32px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:16px}
.am-sidebar__logo{width:40px;height:40px;background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:16px;font-weight:700;color:#fff;flex-shrink:0}
.am-sidebar__name{font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--gold-light);line-height:1.2}
.am-sidebar__role{font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.am-sidebar__nav{display:flex;flex-direction:column;gap:4px;padding:0 12px; height:100%;}
.am-nav-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.55);font-size:14px;font-weight:500;transition:all .2s}
.am-nav-item:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9)}
.am-nav-item.active{background:linear-gradient(135deg,rgba(201,147,58,.2),rgba(201,147,58,.1));color:var(--gold-light);border:1px solid rgba(201,147,58,.2)}
.am-nav-item--danger{color:rgba(230,57,70,.6);}
.am-nav-item--danger:hover button {color:var(--danger);}
.am-nav-item--danger:hover {background:rgba(230,57,70,.1);}

.am-main{flex:1;padding:40px 48px;overflow-y:auto}
.am-topbar{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px}
.am-topbar__title{font-family:var(--font-display);font-size:28px;font-weight:900;color:var(--text);margin-bottom:4px}
.am-topbar__sub{font-size:14px;color:var(--muted)}

.am-alert{padding:14px 18px;border-radius:12px;font-size:14px;font-weight:500;margin-bottom:24px}
.am-alert--success{background:rgba(37,160,102,.1);border:1px solid rgba(37,160,102,.25);color:#1e6b4a}
.am-alert--error{background:rgba(230,57,70,.08);border:1px solid rgba(230,57,70,.2);color:var(--danger)}

.am-settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}

.am-card{background:var(--card);border-radius:24px;padding:32px;box-shadow:var(--shadow);border:1px solid var(--border)}
.am-card__head{display:flex;align-items:flex-start;gap:14px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--border)}
.am-card__head-icon{font-size:28px;flex-shrink:0}
.am-card__title{font-family:var(--font-display);font-size:20px;font-weight:700;color:var(--text);margin-bottom:4px}
.am-card__sub{font-size:13px;color:var(--muted)}

.am-toggle-wrap{display:flex;align-items:center;gap:8px;margin-left:auto;flex-shrink:0}
.am-toggle-label{font-size:12px;font-weight:600;color:var(--muted)}
.am-toggle{width:48px;height:26px;background:#d4c5b0;border:none;border-radius:50px;cursor:pointer;position:relative;transition:background .3s;flex-shrink:0}
.am-toggle--on{background:var(--gold)}
.am-toggle__knob{position:absolute;top:3px;left:3px;width:20px;height:20px;background:#fff;border-radius:50%;transition:transform .3s;box-shadow:0 1px 4px rgba(0,0,0,.2);display:block}
.am-toggle--on .am-toggle__knob{transform:translateX(22px)}

.am-form{display:flex;flex-direction:column;gap:18px}
.am-form__row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.am-field{display:flex;flex-direction:column;gap:7px}
.am-field--icon{flex:0 0 80px}
.am-label{font-size:12px;font-weight:600;color:var(--text);letter-spacing:.02em}
.am-input{padding:12px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;font-family:var(--font-body);color:var(--text);background:var(--bg);outline:none;transition:border-color .2s;width:100%}
.am-input:focus{border-color:var(--gold);background:#fff}
.am-input--emoji{text-align:center;font-size:20px;padding:8px 6px}
.am-textarea{padding:12px 14px;border:1.5px solid var(--border);border-radius:12px;font-size:14px;font-family:var(--font-body);color:var(--text);background:var(--bg);outline:none;resize:vertical;transition:border-color .2s}
.am-textarea:focus{border-color:var(--gold);background:#fff}

.am-dropzone--small{border:2px dashed var(--border);border-radius:12px;padding:18px;text-align:center;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;font-size:13px;color:var(--muted);transition:all .2s}
.am-dropzone--small:hover{border-color:var(--gold);color:var(--gold)}
.am-current-img{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.am-current-img img{width:56px;height:56px;object-fit:cover;border-radius:10px;border:2px solid var(--border)}
.am-current-img span{font-size:12px;color:var(--muted)}

.am-badge-row{display:flex;gap:14px;align-items:flex-end;padding-bottom:14px;border-bottom:1px solid rgba(201,147,58,.08)}
.am-badge-row:last-of-type{border-bottom:none}

.am-form__footer{display:flex;justify-content:flex-end;padding-top:4px}
.am-btn{display:flex;align-items:center;gap:8px;padding:12px 24px;border-radius:12px;font-size:14px;font-weight:600;font-family:var(--font-body);cursor:pointer;text-decoration:none;transition:all .25s;border:none}
.am-btn--primary{background:linear-gradient(135deg,var(--ink),#3d2410);color:#fff;box-shadow:0 4px 16px rgba(26,18,8,.2)}
.am-btn--primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(26,18,8,.3)}

.am-mobile-menu-btn { display: none; background: none; border: none; color: var(--text); cursor: pointer; padding: 4px; margin-top: 4px; }
.am-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 40; backdrop-filter: blur(2px); }

@@media(max-width:1100px){.am-settings-grid{grid-template-columns:1fr}}
@@media(max-width:900px){
    .am-mobile-menu-btn { display: block; }
    .am-main { padding: 24px 20px; }
    .am-form__row{grid-template-columns:1fr}
    .am-sidebar { position: fixed; left: -260px; top: 0; bottom: 0; z-index: 50; transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 4px 0 24px rgba(0,0,0,0.2); }
    .am-sidebar.is-open { left: 0; }
    .am-sidebar-overlay.is-active { display: block; }
}
</style>

<script>
function previewFestive(input){
    if(!input.files[0])return;
    const reader=new FileReader();
    reader.onload=e=>{
        document.getElementById('festivePrev').src=e.target.result;
        document.getElementById('festivePrev').style.display='block';
        document.getElementById('festivePrevText').textContent=input.files[0].name;
    };
    reader.readAsDataURL(input.files[0]);
}

// Mobile Sidebar Logic
document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.querySelector('.am-sidebar');
    
    if (menuBtn && sidebar) {
        const overlay = document.createElement('div');
        overlay.className = 'am-sidebar-overlay';
        document.body.appendChild(overlay);

        menuBtn.addEventListener('click', () => {
            sidebar.classList.add('is-open');
            overlay.classList.add('is-active');
            document.body.style.overflow = 'hidden'; 
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('is-open');
            overlay.classList.remove('is-active');
            document.body.style.overflow = '';
        });
    }
});
</script>