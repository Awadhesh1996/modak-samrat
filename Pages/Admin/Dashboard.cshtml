@page
@model DashboardModel

@{
    ViewData["Title"] = "Dashboard – Modak Samrat Admin";
}

<div class="am-root">

    <!-- SIDEBAR (Unchanged HTML) -->
    <aside class="am-sidebar">
        <div class="am-sidebar__brand">
            <div class="am-sidebar__logo">MS</div>
            <div>
                <div class="am-sidebar__name">Modak Samrat</div>
                <div class="am-sidebar__role">Admin Panel</div>
            </div>
        </div>
        <nav class="am-sidebar__nav">
            <a href="/Admin/Dashboard" class="am-nav-item active">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Dashboard
            </a>
            <a href="/Admin/AddModak" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Add Modak
            </a>
            <a href="/Admin/ManageSettings" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
                Settings
            </a>
            <a href="/Admin/ManageFeedbacks" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                Feedbacks
            </a>
            <a href="/" class="am-nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
                View Store
            </a>
            <form method="post" asp-page-handler="Logout" class="am-nav-item am-nav-item--danger" style="margin-top:auto; background:none; border:none; padding:0;">
                <button type="submit" style="background:none; border:none; color:inherit; font:inherit; display:flex; align-items:center; gap:12px; width:100%; cursor:pointer; padding:12px 14px; border-radius:12px; transition:all 0.2s;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16,17 21,12 16,7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Logout
                </button>
            </form>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="am-main">
        
        <!-- 1. UPDATED TOP BAR HTML -->
        <div class="am-topbar">
            <div style="display: flex; align-items: flex-start; gap: 16px;">
                <button class="am-mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open Menu">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <div>
                    <h1 class="am-topbar__title">Modak Dashboard</h1>
                    <p class="am-topbar__sub">Manage your premium modaks</p>
                </div>
            </div>
            
            <a href="/Admin/AddModak" class="am-btn am-btn--primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Modak
            </a>
        </div>

        <div class="am-card" style="padding:0; overflow:hidden;">
            <div style="overflow-x:auto;">
                <table class="am-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Modaks.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; padding:40px; color:var(--muted);">
                                    No modaks found. Add one to get started!
                                </td>
                            </tr>
                        }
                        @foreach (var modak in Model.Modaks)
                        {
                            <tr>
                                <td>
                                    @if (modak.Images.Count > 0)
                                    {
                                        <img src="@modak.Images[0]" class="am-table__img" alt="@modak.Name">
                                    }
                                    else
                                    {
                                        <div class="am-table__img-placeholder">No Img</div>
                                    }
                                </td>
                                <td style="font-weight:600; color:var(--text);">@modak.Name</td>
                                <td>
                                    <span class="am-badge">@modak.CategoryName</span>
                                </td>
                                <td style="font-weight:600;">₹@modak.Price</td>
                                <td>
                                    <div style="display:flex; gap:8px;">
                                        <a href="/Admin/EditModak?id=@modak.Id" class="am-action-btn">Edit</a>
                                        <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <input type="hidden" name="id" value="@modak.Id" />
                                            <button type="submit" class="am-action-btn am-action-btn--danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<style>
/* Base variables and styles */
:root{--gold:#c9933a;--gold-light:#e8b96a;--gold-dim:#7a5520;--ink:#1a1208;--bg:#f8f4ef;--card:#ffffff;--text:#2d1f0e;--muted:#8b7355;--border:rgba(201,147,58,.18);--danger:#e63946;--font-display:'Playfair Display',Georgia,serif;--font-body:'DM Sans',sans-serif;--shadow:0 4px 24px rgba(0,0,0,.08);--radius:16px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);font-family:var(--font-body);color:var(--text);min-height:100vh}
.am-root{display:flex;min-height:100vh}

/* Sidebar styles */
.am-sidebar{width:240px;background:var(--ink);display:flex;flex-direction:column;padding:28px 0;flex-shrink:0;position:sticky;top:0;height:100vh}
.am-sidebar__brand{display:flex;align-items:center;gap:12px;padding:0 24px 32px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:16px}
.am-sidebar__logo{width:40px;height:40px;background:linear-gradient(135deg,var(--gold-dim),var(--gold));border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:16px;font-weight:700;color:#fff;flex-shrink:0}
.am-sidebar__name{font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--gold-light);line-height:1.2}
.am-sidebar__role{font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;margin-top:2px}
.am-sidebar__nav{display:flex;flex-direction:column;gap:4px;padding:0 12px; height:100%;}
.am-nav-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:12px;text-decoration:none;color:rgba(255,255,255,.55);font-size:14px;font-weight:500;transition:all .2s}
.am-nav-item:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9)}
.am-nav-item.active{background:linear-gradient(135deg,rgba(201,147,58,.2),rgba(201,147,58,.1));color:var(--gold-light);border:1px solid rgba(201,147,58,.2)}
.am-nav-item--danger{color:rgba(230,57,70,.6);}
.am-nav-item--danger:hover button {color:var(--danger);}
.am-nav-item--danger:hover {background:rgba(230,57,70,.1);}

/* Main content styles */
.am-main{flex:1;padding:40px 48px;overflow-y:auto}
.am-topbar{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:32px}
.am-topbar__title{font-family:var(--font-display);font-size:28px;font-weight:900;color:var(--text);margin-bottom:4px}
.am-topbar__sub{font-size:14px;color:var(--muted)}
.am-card{background:var(--card);border-radius:24px;box-shadow:var(--shadow);border:1px solid var(--border)}

/* Table styles */
.am-table {width: 100%; border-collapse: collapse; text-align:left;}
.am-table th {padding: 18px 24px; border-bottom: 2px solid var(--border); font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; background: rgba(248, 244, 239, 0.5);}
.am-table td {padding: 16px 24px; border-bottom: 1px solid var(--border); font-size: 14px; vertical-align: middle;}
.am-table tr:last-child td {border-bottom: none;}
.am-table tr:hover td {background: rgba(201, 147, 58, 0.02);}
.am-table__img {width: 56px; height: 56px; object-fit: cover; border-radius: 12px; border: 1px solid var(--border);}
.am-table__img-placeholder {width: 56px; height: 56px; border-radius: 12px; background: var(--bg); display:flex; align-items:center; justify-content:center; font-size:10px; color:var(--muted); border: 1px dashed var(--border);}

.am-badge {padding: 6px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 50px; font-size: 11px; font-weight: 700; color: var(--gold-dim);}
.am-action-btn {background: var(--card); border: 1.5px solid var(--border); padding: 8px 14px; border-radius: 10px; cursor: pointer; color: var(--muted); font-size: 12px; font-weight: 600; text-decoration: none; transition: all 0.2s;}
.am-action-btn:hover {border-color: var(--gold); color: var(--gold);}
.am-action-btn--danger:hover {border-color: var(--danger); color: var(--danger);}
.am-btn{display:flex;align-items:center;gap:8px;padding:14px 28px;border-radius:14px;font-size:15px;font-weight:600;font-family:var(--font-body);cursor:pointer;text-decoration:none;transition:all .25s;border:none}
.am-btn--primary{background:linear-gradient(135deg,var(--ink),#3d2410);color:#fff;box-shadow:0 4px 20px rgba(26,18,8,.25)}
.am-btn--primary:hover{background:linear-gradient(135deg,#2d1a05,var(--gold-dim));transform:translateY(-1px);box-shadow:0 8px 28px rgba(26,18,8,.35)}

/* 2. UPDATED CSS MEDIA QUERY */
.am-mobile-menu-btn { display: none; background: none; border: none; color: var(--text); cursor: pointer; padding: 4px; margin-top: 4px; }
.am-sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 40; backdrop-filter: blur(2px); }

@@media(max-width:900px) {
    .am-mobile-menu-btn { display: block; }
    .am-main { padding: 24px 20px; }
    
    .am-sidebar { 
        position: fixed; 
        left: -260px; /* Hide off screen */
        top: 0;
        bottom: 0;
        z-index: 50;
        transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 4px 0 24px rgba(0,0,0,0.2);
    }
    
    .am-sidebar.is-open { left: 0; }
    .am-sidebar-overlay.is-active { display: block; }
}
</style>

<!-- 3. ADDED TOGGLE SCRIPT -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobileMenuBtn');
    const sidebar = document.querySelector('.am-sidebar');
    
    if (menuBtn && sidebar) {
        const overlay = document.createElement('div');
        overlay.className = 'am-sidebar-overlay';
        document.body.appendChild(overlay);

        menuBtn.addEventListener('click', () => {
            sidebar.classList.add('is-open');
            overlay.classList.add('is-active');
            document.body.style.overflow = 'hidden'; 
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('is-open');
            overlay.classList.remove('is-active');
            document.body.style.overflow = '';
        });
    }
});
</script>