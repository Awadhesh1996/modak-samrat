@page
@model DetailsModel

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500&family=Cormorant+Garamond:ital,wght@1,300;1,500&display=swap" rel="stylesheet">

<div class="dp-root" id="dpRoot">

    <!-- TOP NAV BAR -->
    <nav class="dp-nav">
        <a href="/" class="dp-back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            <span>Back</span>
        </a>
        <div class="dp-nav__logo">Modak Samrat</div>
        <a href="javascript:void(0)" onclick="orderWhatsApp()" class="dp-nav__wa">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Order Now
        </a>
    </nav>

    <!-- MAIN LAYOUT -->
    <div class="dp-main">

        <!-- LEFT: GALLERY -->
        <div class="dp-gallery" id="gallery">

            <!-- MAIN IMAGE -->
            <div class="dp-gallery__main">
                <img id="mainImg"
                     src="@Model.Modak.Images.FirstOrDefault()"
                     alt="@Model.Modak.Name"
                     class="dp-gallery__main-img">
                <div class="dp-gallery__main-overlay"></div>
                <div class="dp-gallery__badge">@Model.Modak.CategoryName</div>

                <!-- ARROWS (only if multiple images) -->
                @if (Model.Modak.Images.Count > 1)
                {
                    <button class="dp-arrow dp-arrow--prev" onclick="changeMain(-1)">‹</button>
                    <button class="dp-arrow dp-arrow--next" onclick="changeMain(1)">›</button>
                }

                <!-- ZOOM HINT -->
                <div class="dp-zoom-hint">Hover to zoom</div>
            </div>

            <!-- THUMBNAILS -->
            @if (Model.Modak.Images.Count > 1)
            {
                <div class="dp-thumbs">
                    @for (int i = 0; i < Model.Modak.Images.Count; i++)
                    {
                        <div class="dp-thumb @(i == 0 ? "active" : "")"
                             onclick="setMain('@Model.Modak.Images[i]', this, @i)"
                             data-index="@i">
                            <img src="@Model.Modak.Images[i]" alt="View @(i+1)">
                        </div>
                    }
                </div>
            }

        </div>

        <!-- RIGHT: INFO -->
        <div class="dp-info">

            <!-- CATEGORY CHIP -->
            <div class="dp-chip">@Model.Modak.CategoryName</div>

            <!-- NAME -->
            <h1 class="dp-name">@Model.Modak.Name</h1>

            <!-- DIVIDER -->
            <div class="dp-divider">
                <div class="dp-divider__line"></div>
                <span class="dp-divider__ornament">✦</span>
                <div class="dp-divider__line"></div>
            </div>

            <!-- PRICE -->
            <div class="dp-price-row">
                <div class="dp-price">
                    <span class="dp-price__symbol">₹</span>
                    <span class="dp-price__value" id="detailPrice" data-baseprice="@Model.Modak.Price">@Model.Modak.Price</span>
                </div>
                <div class="dp-price__note">per piece</div>
            </div>

            <!-- DESC -->
            <p class="dp-desc">@Model.Modak.Description</p>

            <!-- FEATURES -->
            <div class="dp-features">
                <div class="dp-feature">
                    <span class="dp-feature__icon">🌿</span>
                    <span>Pure Ingredients</span>
                </div>
                <div class="dp-feature">
                    <span class="dp-feature__icon">🏺</span>
                    <span>Traditional Recipe</span>
                </div>
                <div class="dp-feature">
                    <span class="dp-feature__icon">🚚</span>
                    <span>Fresh Delivery</span>
                </div>
            </div>

            <!-- QTY SELECTOR -->
            <div class="dp-qty-section">
                <label class="dp-qty-label">Quantity</label>
                <div class="dp-qty-row">
                    <div class="dp-qty">
                        <button class="dp-qty__btn" onclick="changeQty(-1)">−</button>
                        <input type="number"
                               id="qty"
                               class="dp-qty__input"
                               value="1"
                               min="1"
                               oninput="syncPrice()">
                        <button class="dp-qty__btn" onclick="changeQty(1)">+</button>
                    </div>
                    <div class="dp-qty-total">
                        Total: <strong id="qtyTotal">₹@Model.Modak.Price</strong>
                    </div>
                </div>
            </div>

            <!-- CTA BUTTONS -->
            <div class="dp-cta">
                <button class="dp-btn dp-btn--cart" onclick="addToCart()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                    Add to Cart
                </button>
                <a href="javascript:void(0)"
                   onclick="orderWhatsApp()"
                   class="dp-btn dp-btn--wa">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                    Order on WhatsApp
                </a>
            </div>

            <!-- TOAST -->
            <div class="dp-toast" id="toast">✓ Added to cart</div>

        </div>
    </div>

    <!-- RELATED SECTION -->
    @if (Model.RelatedModaks.Count > 0)
    {
        <section class="dp-related">
            <div class="dp-related__head">
                <div class="dp-related__line"></div>
                <h2 class="dp-related__title">You May Also Like</h2>
                <div class="dp-related__line"></div>
            </div>

            <div class="dp-related__grid">
                @foreach (var item in Model.RelatedModaks)
                {
                    <a href="/Details?id=@item.Id" class="dp-related-card">
                        <div class="dp-related-card__img-wrap">
                            <img src="@item.Images.FirstOrDefault()"
                                 alt="@item.Name"
                                 class="dp-related-card__img">
                            <div class="dp-related-card__overlay"></div>
                        </div>
                        <div class="dp-related-card__body">
                            <div class="dp-related-card__name">@item.Name</div>
                            <div class="dp-related-card__price">₹@item.Price</div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- FOOTER -->
    <footer class="dp-footer">
        <div class="dp-footer__brand">Modak Samrat</div>
        <p class="dp-footer__copy">Handcrafted with love · Pure ingredients · Ancient recipes</p>
    </footer>

</div>

<style>

/* ─── TOKENS ─────────────────────────────────────────── */
:root {
    --gold:        #c9933a;
    --gold-light:  #e8b96a;
    --gold-dim:    #7a5520;
    --ink:         #1a1208;
    --cream:       #fdf6ec;
    --cream2:      #f5ead8;
    --card-bg:     #ffffff;
    --text:        #2d1f0e;
    --muted:       #8b7355;
    --radius:      20px;
    --shadow:      0 8px 40px rgba(0,0,0,0.10);
    --font-display:'Playfair Display', Georgia, serif;
    --font-body:   'DM Sans', sans-serif;
    --font-italic: 'Cormorant Garamond', Georgia, serif;
}

/* ─── BASE ───────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--cream);
    font-family: var(--font-body);
    color: var(--text);
    min-height: 100vh;
}

/* ─── NAV ────────────────────────────────────────────── */
.dp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 36px;
    background: var(--ink);
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(201,147,58,0.2);
}

.dp-back {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s;
}
.dp-back:hover { color: var(--gold); }

.dp-nav__logo {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--gold-light);
    letter-spacing: 0.03em;
}

.dp-nav__wa {
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #128c7e, #25d366);
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 50px;
    transition: all 0.25s;
    box-shadow: 0 4px 16px rgba(37,211,102,0.3);
}
.dp-nav__wa:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(37,211,102,0.4);
}

/* ─── MAIN LAYOUT ────────────────────────────────────── */
.dp-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    max-width: 1300px;
    margin: 0 auto;
    padding: 50px 40px;
    align-items: start;
    gap: 60px;
}

/* ─── GALLERY ────────────────────────────────────────── */
.dp-gallery { position: sticky; top: 80px; }

.dp-gallery__main {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--cream2);
    aspect-ratio: 1;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    cursor: zoom-in;
}

.dp-gallery__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
}
.dp-gallery__main:hover .dp-gallery__main-img {
    transform: scale(1.06);
}

.dp-gallery__main-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(26,18,8,0.35) 0%, transparent 40%);
    pointer-events: none;
}

.dp-gallery__badge {
    position: absolute;
    bottom: 20px; left: 20px;
    background: rgba(201,147,58,0.92);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 50px;
}

.dp-zoom-hint {
    position: absolute;
    bottom: 20px; right: 20px;
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.05em;
}

.dp-arrow {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    width: 42px; height: 42px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s;
    display: flex; align-items: center; justify-content: center;
    line-height: 1;
    opacity: 0;
}
.dp-gallery__main:hover .dp-arrow { opacity: 1; }
.dp-arrow:hover { background: rgba(201,147,58,0.7); }
.dp-arrow--prev { left: 14px; }
.dp-arrow--next { right: 14px; }

/* THUMBS */
.dp-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.dp-thumb {
    width: 80px; height: 80px;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.25s;
    background: var(--cream2);
    flex-shrink: 0;
}
.dp-thumb img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}
.dp-thumb:hover img { transform: scale(1.08); }
.dp-thumb.active {
    border-color: var(--gold);
    box-shadow: 0 0 0 2px rgba(201,147,58,0.3);
}

/* ─── INFO PANEL ─────────────────────────────────────── */
.dp-info {
    padding-top: 10px;
}

.dp-chip {
    display: inline-block;
    background: linear-gradient(135deg, var(--gold-dim), var(--gold));
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 6px 16px;
    border-radius: 50px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px rgba(201,147,58,0.3);
}

.dp-name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 900;
    color: var(--text);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
}

.dp-divider {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
}
.dp-divider__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(201,147,58,0.4), transparent);
}
.dp-divider__ornament { color: var(--gold); font-size: 12px; }

/* PRICE */
.dp-price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
}

.dp-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
}

.dp-price__symbol {
    font-size: 24px;
    font-weight: 600;
    color: var(--gold);
}

.dp-price__value {
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 900;
    color: var(--gold);
    line-height: 1;
}

.dp-price__note {
    font-size: 13px;
    color: var(--muted);
    align-self: flex-end;
    padding-bottom: 8px;
}

/* DESC */
.dp-desc {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 28px;
    font-weight: 300;
}

/* FEATURES */
.dp-features {
    display: flex;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

.dp-feature {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--cream2);
    border: 1px solid rgba(201,147,58,0.15);
    border-radius: 50px;
    padding: 8px 16px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
}
.dp-feature__icon { font-size: 16px; }

/* QTY */
.dp-qty-section { margin-bottom: 28px; }

.dp-qty-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
}

.dp-qty-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.dp-qty {
    display: flex;
    align-items: center;
    background: var(--cream2);
    border: 1.5px solid rgba(201,147,58,0.2);
    border-radius: 50px;
    overflow: hidden;
    gap: 4px;
    padding: 4px;
}

.dp-qty__btn {
    width: 40px; height: 40px;
    border: none;
    background: var(--card-bg);
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
    color: var(--text);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: all 0.2s;
    line-height: 1;
}
.dp-qty__btn:hover { background: var(--gold); color: #fff; }

.dp-qty__input {
    width: 50px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    font-family: var(--font-display);
    outline: none;
}

.dp-qty-total {
    font-size: 14px;
    color: var(--muted);
}
.dp-qty-total strong {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    display: block;
}

/* CTA */
.dp-cta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
}

.dp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 24px;
    border: none;
    border-radius: 16px;
    font-size: 16px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(.22,.61,.36,1);
    letter-spacing: 0.02em;
}

.dp-btn--cart {
    background: linear-gradient(135deg, #1a1208, #3d2410);
    color: #fff;
    box-shadow: 0 6px 30px rgba(26,18,8,0.3);
}
.dp-btn--cart:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(26,18,8,0.4);
    background: linear-gradient(135deg, #2d1a05, var(--gold-dim));
}

.dp-btn--wa {
    background: linear-gradient(135deg, #128c7e, #25d366);
    color: #fff;
    box-shadow: 0 6px 30px rgba(37,211,102,0.25);
}
.dp-btn--wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(37,211,102,0.4);
}

/* TOAST */
.dp-toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: #1a1208;
    color: #fff;
    padding: 14px 28px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    border-left: 3px solid var(--gold);
    box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    transition: transform 0.4s cubic-bezier(.22,.61,.36,1);
    z-index: 200;
    white-space: nowrap;
}
.dp-toast.show { transform: translateX(-50%) translateY(0); }

/* ─── RELATED ─────────────────────────────────────────── */
.dp-related {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px 60px;
}

.dp-related__head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 32px;
}
.dp-related__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201,147,58,0.3), transparent);
}
.dp-related__title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
}

.dp-related__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
}

.dp-related-card {
    text-decoration: none;
    color: var(--text);
    background: var(--card-bg);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid rgba(201,147,58,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s;
}
.dp-related-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 50px rgba(0,0,0,0.14);
}

.dp-related-card__img-wrap {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--cream2);
}
.dp-related-card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
}
.dp-related-card:hover .dp-related-card__img { transform: scale(1.07); }
.dp-related-card__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(26,18,8,0.4) 0%, transparent 50%);
    pointer-events: none;
}

.dp-related-card__body { padding: 14px 16px 16px; }
.dp-related-card__name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text);
}
.dp-related-card__price {
    font-size: 18px;
    font-weight: 700;
    color: var(--gold);
    font-family: var(--font-display);
}

/* ─── FOOTER ─────────────────────────────────────────── */
.dp-footer {
    background: var(--ink);
    color: rgba(255,255,255,0.4);
    text-align: center;
    padding: 40px 20px;
}
.dp-footer__brand {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--gold-light);
    margin-bottom: 8px;
}
.dp-footer__copy { font-size: 13px; letter-spacing: 0.05em; }

/* ─── ANIMATIONS ─────────────────────────────────────── */
@@keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
}

.dp-gallery { animation: fadeUp 0.7s ease 0.1s both; }
.dp-chip    { animation: fadeUp 0.6s ease 0.2s both; }
.dp-name    { animation: fadeUp 0.7s ease 0.3s both; }
.dp-price-row { animation: fadeUp 0.6s ease 0.4s both; }
.dp-desc    { animation: fadeUp 0.6s ease 0.45s both; }
.dp-features { animation: fadeUp 0.6s ease 0.5s both; }
.dp-qty-section { animation: fadeUp 0.6s ease 0.55s both; }
.dp-cta     { animation: fadeUp 0.6s ease 0.6s both; }

/* ─── MOBILE ─────────────────────────────────────────── */
@@media (max-width: 900px) {
    .dp-main {
        grid-template-columns: 1fr;
        padding: 24px 20px;
        gap: 32px;
    }
    .dp-gallery { position: static; }
    .dp-nav { padding: 14px 20px; }
    .dp-nav__logo { display: none; }
    .dp-price__value { font-size: 40px; }
    .dp-related { padding: 0 20px 40px; }
    .dp-related__grid { grid-template-columns: repeat(2, 1fr); }
}

@@media (max-width: 480px) {
    .dp-features { gap: 10px; }
    .dp-feature { font-size: 12px; padding: 6px 12px; }
    .dp-name { font-size: 32px; }
    .dp-thumbs { gap: 8px; }
    .dp-thumb { width: 64px; height: 64px; border-radius: 10px; }
}

</style>

<script>

const basePrice = @Model.Modak.Price;
let currentIndex = 0;
const images = [@Html.Raw(string.Join(",", Model.Modak.Images.Select(i => $"\"{i}\"")))] || [];

/* ─── MAIN IMAGE ─────────────────────────── */
function setMain(src, thumbEl, index) {
    document.getElementById('mainImg').src = src;
    currentIndex = index;
    document.querySelectorAll('.dp-thumb').forEach(t => t.classList.remove('active'));
    if (thumbEl) thumbEl.classList.add('active');
}

function changeMain(dir) {
    if (!images.length) return;
    currentIndex = (currentIndex + dir + images.length) % images.length;
    document.getElementById('mainImg').src = images[currentIndex];
    const thumbs = document.querySelectorAll('.dp-thumb');
    thumbs.forEach((t, i) => t.classList.toggle('active', i === currentIndex));
}

/* ─── QTY & PRICE ────────────────────────── */
function changeQty(delta) {
    const input = document.getElementById('qty');
    let v = Math.max(1, parseInt(input.value) + delta);
    input.value = v;
    syncPrice();
}

function syncPrice() {
    const qty = Math.max(1, parseInt(document.getElementById('qty').value) || 1);
    document.getElementById('qty').value = qty;
    document.getElementById('qtyTotal').textContent = '₹' + (basePrice * qty);
}

/* ─── CART ───────────────────────────────── */
function addToCart() {
    const qty = parseInt(document.getElementById('qty').value);
    const name = "@Model.Modak.Name";
    const items = JSON.parse(localStorage.getItem('msCart') || '[]');
    const existing = items.find(i => i.name === name);
    if (existing) { existing.qty += qty; existing.total = existing.price * existing.qty; }
    else items.push({ name, price: basePrice, qty, total: basePrice * qty });
    localStorage.setItem('msCart', JSON.stringify(items));
    showToast('✓ Added ' + qty + ' to cart');
}

function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2800);
}

/* ─── WHATSAPP ───────────────────────────── */
function orderWhatsApp() {
    const qty = document.getElementById('qty').value;
    const total = basePrice * parseInt(qty);
    const msg =
        "Hello Modak Samrat!%0A%0A" +
        "*I'd like to order:*%0A" +
        "• @Model.Modak.Name × " + qty + " = ₹" + total + "%0A%0A" +
        "Please confirm availability and delivery. Thank you!";
    window.open('https://wa.me/917021923652?text=' + msg, '_blank');
}

</script>
